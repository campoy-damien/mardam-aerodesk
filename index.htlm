  toast(`PDF Programme Activité ${year} ✓`);
}


/* ═══ EXPORT WEEKLY ═══ */
/* ═══ EXTRAIT DU JOUR ═══ */
function openDayExtract(){
  if(!S.weekStart) S.weekStart=getMon(new Date());
  const sel=document.getElementById('dayextract-select');
  const JOURS=['Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi','Dimanche'];
  sel.innerHTML='';
  for(let i=0;i<7;i++){
    const d=addD(S.weekStart,i);
    const ds=fmt(d);
    const ferie=isHol(ds)?` 🎉 Férié`:'';
    const o=document.createElement('option');
    o.value=i;
    o.textContent=`${JOURS[i]} ${d.getDate()}/${d.getMonth()+1}/${d.getFullYear()}${ferie}`;
    sel.appendChild(o);
  }
  // Sélectionne aujourd'hui si dans la semaine
  const today=new Date();
  const todayFmt=fmt(today);
  for(let i=0;i<7;i++){
    if(fmt(addD(S.weekStart,i))===todayFmt){sel.selectedIndex=i;break;}
  }
  sel.onchange=previewDayExtract;
  previewDayExtract();
  openM('m-dayextract');
}

function previewDayExtract(){
  const i=parseInt(document.getElementById('dayextract-select').value)||0;
  const d=addD(S.weekStart,i);
  const ds=fmt(d);
  const JOURS=['Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi','Dimanche'];
  const dName=JOURS[d.getDay()===0?6:d.getDay()-1];

  const sorted=sortByChantier(S.personnel,[d]);
  let count=0;
  const lines=sorted.map(emp=>{
    const am=S.planning[`${emp.id}_${ds}_AM`]||{};
    const pm=S.planning[`${emp.id}_${ds}_PM`]||{};
    const cat=CATS[emp.categorie]||{};
    if(!am.type&&!pm.type) return null;
    count++;
    const amLbl=cellLabel(am);
    const pmLbl=cellLabel(pm);
    return`<div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid rgba(255,255,255,0.05)">
      <span style="color:${cat.col||'var(--t2)'}"><strong>${emp.trigramme}</strong> ${emp.prenom} ${emp.nom}</span>
      <span style="color:var(--t3);font-size:11px">${amLbl} · ${pmLbl}</span>
    </div>`;
  }).filter(Boolean).join('');

  document.getElementById('dayextract-preview').innerHTML=
    `<div style="font-size:12px;font-weight:700;color:var(--cyan);margin-bottom:8px">${dName} ${d.getDate()}/${d.getMonth()+1} — ${count} personne(s) renseignées</div>${lines||'<span style="color:var(--t4)">Aucun planning saisi pour ce jour</span>'}`;
}

function cellLabel(entry){
  if(!entry||!entry.type) return '—';
  const LABELS={travail:'Travail',conge:'Congé',maladie:'Maladie',formation:'Formation',
    absence:'Absence',deplacement:'Déplacement',ferie:'Férié',we:'W-E'};
  let l=LABELS[entry.type]||entry.type;
  if(entry.type==='travail'&&entry.chantierId){
    const ch=S.chantiers.find(c=>c.id===entry.chantierId);
    if(ch) l=ch.nom.slice(0,20);
  }
  return l;
}

function exportDayHtml(){
  const i=parseInt(document.getElementById('dayextract-select').value)||0;
  const d=addD(S.weekStart,i);
  const ds=fmt(d);
  const JOURS=['Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi','Dimanche'];
  const dName=JOURS[d.getDay()===0?6:d.getDay()-1];
  const dateStr=`${dName} ${d.getDate()} ${['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'][d.getMonth()]} ${d.getFullYear()}`;
  const CELL_COLORS={travail:'#1a3a5c',conge:'#1a3d1a',maladie:'#3d1a1a',formation:'#2a1a3d',
    absence:'#3d2a1a',deplacement:'#1a2a3d',ferie:'#2d2d1a',we:'#1a1a2d'};
  const CELL_TEXT={travail:'#60b4ff',conge:'#60d080',maladie:'#ff8080',formation:'#b080ff',
    absence:'#ffb060',deplacement:'#60c0ff',ferie:'#ffff80',we:'#8080a0'};

  const sorted=sortByChantier(S.personnel,[d]);
  let lastGroup='';

  const rows=sorted.map(emp=>{
    const cat=CATS[emp.categorie]||{};
    const am=S.planning[`${emp.id}_${ds}_AM`]||{type:'travail'};
    const pm=S.planning[`${emp.id}_${ds}_PM`]||{type:'travail'};

    const cellHtml=(entry)=>{
      const bg=CELL_COLORS[entry.type||'travail']||'#1a3a5c';
      const tc=CELL_TEXT[entry.type||'travail']||'#60b4ff';
      let label=cellLabel(entry);
      return`<td style="padding:7px 10px;background:${bg};border:1px solid rgba(255,255,255,0.06);text-align:center;font-size:11px;font-weight:700;color:${tc};white-space:nowrap">${label}</td>`;
    };

    // Groupe chantier
    const chantierId=am.chantierId||pm.chantierId||'__aucun__';
    let sepRow='';
    if(chantierId!==lastGroup){
      lastGroup=chantierId;
      const ch=S.chantiers.find(c=>c.id===chantierId);
      const grpLabel=ch?`🔧 ${ch.nom}`:'📋 Sans chantier assigné';
      const grpColor=ch?.color||'rgba(255,255,255,0.1)';
      sepRow=`<tr><td colspan="5" style="padding:5px 10px;background:${grpColor}18;border-top:2px solid ${grpColor}55;font-size:10px;font-weight:800;color:${grpColor==='rgba(255,255,255,0.1)'?'#6080a0':grpColor};text-transform:uppercase;letter-spacing:.8px">${grpLabel}</td></tr>`;
    }

    return sepRow+`<tr>
      <td style="padding:7px 10px;background:${cat.col||'#1a2a3d'}18;border:1px solid rgba(255,255,255,0.06);border-left:3px solid ${cat.col||'#2979ff'};white-space:nowrap">
        <span style="font-weight:800;color:${cat.col||'#60b4ff'};font-family:monospace;font-size:12px">${emp.trigramme}</span>
      </td>
      <td style="padding:7px 10px;background:#0d1628;border:1px solid rgba(255,255,255,0.06);white-space:nowrap">
        <span style="font-weight:700;color:#e0eaff;font-size:12px">${emp.prenom} ${emp.nom}</span>
      </td>
      <td style="padding:7px 10px;background:#0d1628;border:1px solid rgba(255,255,255,0.06);text-align:center">
        <span style="font-size:10px;color:#6080a0">${cat.lbl||emp.categorie}</span>
      </td>
      ${cellHtml(am)}${cellHtml(pm)}
    </tr>`;
  }).join('');

  const html=`<!DOCTYPE html>
<html lang="fr"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Planning ${dateStr}</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&display=swap');
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:'Outfit',sans-serif;background:#060a12;color:#e0eaff;padding:20px;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid rgba(255,255,255,0.1)}
  .logo{font-size:22px;font-weight:900;letter-spacing:-.5px}
  .logo span{background:linear-gradient(90deg,#00d2ff,#00e5b0);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
  .date-badge{font-size:18px;font-weight:800;color:#00d2ff;background:rgba(0,210,255,0.08);border:1px solid rgba(0,210,255,0.2);border-radius:12px;padding:8px 18px}
  table{width:100%;border-collapse:collapse;margin-top:16px}
  th{background:#0d1628;color:#6080a0;padding:8px 10px;border:1px solid rgba(255,255,255,0.08);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;text-align:center}
  th:nth-child(2){text-align:left}
  .footer{margin-top:20px;font-size:11px;color:#3a4a6a;text-align:right}
  .legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:16px;padding:12px;background:rgba(255,255,255,0.03);border-radius:10px}
  .leg{display:flex;align-items:center;gap:6px;font-size:11px;color:#8090b0}
  .leg-dot{width:10px;height:10px;border-radius:3px}
  @media print{body{background:#060a12!important}*{-webkit-print-color-adjust:exact!important}}
</style>
</head>
<body>
  <div class="header">
    <div class="logo">✈️ AeroStaff <span>Pro</span></div>
    <div class="date-badge">📅 ${dateStr}</div>
  </div>

  <table>
    <thead><tr>
      <th style="width:60px">TRI</th>
      <th style="text-align:left">Nom</th>
      <th>Catégorie</th>
      <th style="width:160px">Matin (AM)</th>
      <th style="width:160px">Après-midi (PM)</th>
    </tr></thead>
    <tbody>${rows}</tbody>
  </table>

  <div class="legend">
    <div class="leg"><div class="leg-dot" style="background:#60b4ff"></div>Travail</div>
    <div class="leg"><div class="leg-dot" style="background:#60d080"></div>Congé</div>
    <div class="leg"><div class="leg-dot" style="background:#ff8080"></div>Maladie</div>
    <div class="leg"><div class="leg-dot" style="background:#b080ff"></div>Formation</div>
    <div class="leg"><div class="leg-dot" style="background:#ffb060"></div>Absence</div>
    <div class="leg"><div class="leg-dot" style="background:#60c0ff"></div>Déplacement</div>
    <div class="leg"><div class="leg-dot" style="background:#ffff80"></div>Jour Férié</div>
  </div>

  <div class="footer">Généré le ${new Date().toLocaleDateString('fr-FR',{weekday:'long',year:'numeric',month:'long',day:'numeric'})} · AeroStaff Pro</div>
  <script>window.onload=()=>setTimeout(()=>window.print(),300)<\/script>

<!-- Footer copyright -->
<div id="copyright-footer" style="
  position:fixed;bottom:0;left:0;right:0;
  background:rgba(6,10,18,0.92);
  border-top:1px solid rgba(255,255,255,0.05);
  padding:4px 16px;
  display:flex;align-items:center;justify-content:center;
  font-size:9px;color:rgba(74,106,154,0.8);
  font-family:'JetBrains Mono',monospace;
  letter-spacing:0.8px;
  pointer-events:none;
  z-index:10;
  backdrop-filter:blur(8px);
">
  © 2025 Damien Campoy — MARDAM AeroDesk Pro · Tous droits réservés · Reproduction interdite
</div>
</body></html>`;

  const blob=new Blob([html],{type:'text/html;charset=utf-8'});
  const url=URL.createObjectURL(blob);
  const w=window.open(url,'_blank');
  if(!w) alert('Autorise les popups pour générer l\'extrait.');
  setTimeout(()=>URL.revokeObjectURL(url),15000);
  closeM('m-dayextract');
  toast(`Extrait ${dateStr} généré ✓`);
}

function exportWeekXls(){
  if(window._xlsxFailed||typeof XLSX==='undefined'){toast('Export Excel non disponible hors ligne');return;}
  if(!S.weekStart) S.weekStart=getMon(new Date());

  // Couleurs chantiers — rotation palette
  const PALETTE=['FF4FC3F7','FF81C784','FFFFB74D','FFBA68C8','FF4DB6AC','FFFF8A65','FF90A4AE','FF64B5F6','FFA5D6A7','FFFFF176'];
  const chanCol={};
  S.chantiers.forEach((c,i)=>{ chanCol[c.id]=PALETTE[i%PALETTE.length]; });

  // Couleurs types
  const TYPE_BG={
    conge:'FFFFFF00',    // jaune vif
    maladie:'FFFF5252',  // rouge
    formation:'FFCE93D8',// violet clair
    absence:'FFFFCC80',  // orange clair
    deplacement:'FF80DEEA',// cyan
    ferie:'FFB0BEC5',    // gris bleu
    we:'FFE0E0E0',       // gris clair
    travail:'FFFFFFFF',  // blanc
    '':'FFFFFFFF'
  };
  const TYPE_FG={
    conge:'FF000000', maladie:'FFFFFFFF', formation:'FF000000',
    absence:'FF000000', deplacement:'FF000000', ferie:'FF424242',
    we:'FF757575', travail:'FF000000', '':'FF000000'
  };

  const dates=[];
  for(let i=0;i<7;i++) dates.push(addD(S.weekStart,i));
  const D3FR=['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'];

  // ── Ligne entête dates ──
  const H=[
    {v:'Nom / Trigramme', s:{font:{bold:true,color:{rgb:'FFFFFFFF'}},fill:{fgColor:{rgb:'FF1A1A2E'}},alignment:{horizontal:'center'}}},
    {v:'Catégorie', s:{font:{bold:true,color:{rgb:'FFFFFFFF'}},fill:{fgColor:{rgb:'FF1A1A2E'}},alignment:{horizontal:'center'}}},
  ];
  dates.forEach(d=>{
    const wd=d.getDay(); const di=wd===0?6:wd-1;
    const isW=wd===0||wd===6; const isH=isHol(fmt(d));
    const label=`${D3FR[di]} ${d.getDate()}/${d.getMonth()+1}${isH?' Férié':isW?' WE':''}`;
    const bg=isH?'FFB0BEC5':isW?'FFE0E0E0':'FF1A3A6B';
    H.push({v:label,s:{font:{bold:true,color:{rgb:'FFFFFFFF'}},fill:{fgColor:{rgb:bg}},alignment:{horizontal:'center',wrapText:true}}});
    H.push({v:'',s:{font:{bold:true,color:{rgb:'FFFFFFFF'}},fill:{fgColor:{rgb:bg}},alignment:{horizontal:'center'}}});
  });

  const rows=[H];

  // ── Sous-entête AM/PM ──
  const H2=[
    {v:'',s:{fill:{fgColor:{rgb:'FF1A1A2E'}}}},
    {v:'',s:{fill:{fgColor:{rgb:'FF1A1A2E'}}}},
  ];
  dates.forEach(d=>{
    const wd=d.getDay(); const isW=wd===0||wd===6; const isH=isHol(fmt(d));
    const bg=isH?'FFB0BEC5':isW?'FFE0E0E0':'FF263A6B';
    ['AM','PM'].forEach(h=>{
      H2.push({v:h,s:{font:{bold:true,sz:8,color:{rgb:'FFFFFFFF'}},fill:{fgColor:{rgb:bg}},alignment:{horizontal:'center'}}});
    });
  });
  rows.push(H2);

  // ── Lignes personnel ──
  S.personnel.filter(p=>p.categorie!=='interimaire'||p.actif!==false).forEach(emp=>{
    const cat=CATS[emp.categorie]||{};
    const nameBg='FF0D0D1A';
    const row=[
      {v:`${emp.prenom} ${emp.nom} (${emp.trigramme})`, s:{font:{bold:true,color:{rgb:'FFFFFFFF'}},fill:{fgColor:{rgb:nameBg}},alignment:{vertical:'center'}}},
      {v:cat.lbl||emp.categorie, s:{font:{color:{rgb:'FFB0C0E0'}},fill:{fgColor:{rgb:nameBg}},alignment:{horizontal:'center',vertical:'center'}}},
    ];
    dates.forEach(d=>{
      const ds=fmt(d); const wd=d.getDay();
      const isW=wd===0||wd===6; const isH=isHol(ds);
      ['AM','PM'].forEach(half=>{
        const entry=S.planning[`${emp.id}_${ds}_${half}`]||{};
        const t=entry.type||(isH?'ferie':isW?'we':'');
        let txt='';
        if(t==='travail'&&entry.chantierId){
          const ch=S.chantiers.find(c=>c.id===entry.chantierId);
          txt=ch?ch.nom.slice(0,20):'Travail';
        } else if(t==='conge') txt='Congé';
        else if(t==='maladie') txt='Maladie';
        else if(t==='formation') txt='Formation';
        else if(t==='absence') txt='Absence';
        else if(t==='deplacement') txt='Déplacement';
        else if(t==='ferie') txt='Férié';
        else if(t==='we') txt='W-E';

        let bg=TYPE_BG[t]||'FFFFFFFF';
        let fg=TYPE_FG[t]||'FF000000';
        if(t==='travail'&&entry.chantierId) bg=chanCol[entry.chantierId]||'FF4FC3F7';

        row.push({v:txt,s:{
          font:{bold:!!txt&&t==='travail',sz:9,color:{rgb:fg}},
          fill:{fgColor:{rgb:bg}},
          alignment:{horizontal:'center',vertical:'center',wrapText:true},
          border:{top:{style:'thin',color:{rgb:'FFD0D0D0'}},bottom:{style:'thin',color:{rgb:'FFD0D0D0'}},left:{style:'thin',color:{rgb:'FFD0D0D0'}},right:{style:'thin',color:{rgb:'FFD0D0D0'}}}
        }});
      });
    });
    rows.push(row);
  });

  // Build sheet
  const ws=XLSX.utils.aoa_to_sheet(rows.map(r=>r.map(c=>typeof c==='object'?c.v:c)));
  // Apply styles
  rows.forEach((row,ri)=>row.forEach((cell,ci)=>{
    if(typeof cell==='object'&&cell.s){
      const addr=XLSX.utils.encode_cell({r:ri,c:ci});
      if(!ws[addr]) ws[addr]={v:cell.v,t:'s'};
      ws[addr].s=cell.s;
    }
  }));

  // Column widths
  ws['!cols']=[{wch:28},{wch:14},...Array(14).fill({wch:14})];
  ws['!rows']=rows.map((_,i)=>i===0?{hpt:28}:i===1?{hpt:16}:{hpt:22});

  // Merge date headers (AM+PM pairs)
  ws['!merges']=[];
  dates.forEach((_,i)=>{ ws['!merges'].push({s:{r:0,c:2+i*2},e:{r:0,c:2+i*2+1}}); });

  const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,`S${wkN(S.weekStart)}`);
  XLSX.writeFile(wb,`MARDAM_Planning_S${wkN(S.weekStart)}_${S.weekStart.getFullYear()}.xlsx`);
  toast(`Export Planning S${wkN(S.weekStart)} téléchargé ✓`);
}

/* ═══ EXPORT MASTER PLANNING ═══ */
function exportMasterXls(){
  if(window._xlsxFailed||typeof XLSX==='undefined'){toast('Export Excel non disponible hors ligne');return;}
  const year=S.masterYear; const month=S.masterMonth;
  const n=new Date(year,month+1,0).getDate();
  const dates=Array.from({length:n},(_,i)=>new Date(year,month,i+1));
  const empF=document.getElementById('mp-emp')?.value||'';
  const emps=empF?S.personnel.filter(p=>p.id===empF):S.personnel.filter(p=>p.categorie!=='interimaire'||p.actif!==false);

  const PALETTE=['FF4FC3F7','FF81C784','FFFFB74D','FFBA68C8','FF4DB6AC','FFFF8A65','FF90A4AE','FF64B5F6','FFA5D6A7','FFFFF176'];
  const chanCol={};
  S.chantiers.forEach((c,i)=>{ chanCol[c.id]=PALETTE[i%PALETTE.length]; });

  const TYPE_BG={conge:'FFFFFF00',maladie:'FFFF5252',formation:'FFCE93D8',absence:'FFFFCC80',deplacement:'FF80DEEA',ferie:'FFB0BEC5',we:'FFE0E0E0',travail:'FFFFFFFF','':'FFFFFFFF'};
  const TYPE_FG={conge:'FF000000',maladie:'FFFFFFFF',formation:'FF000000',absence:'FF000000',deplacement:'FF000000',ferie:'FF424242',we:'FF757575',travail:'FF000000','':'FF000000'};
  const D3FR=['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'];

  // Header dates
  const H=[
    {v:`${MO[month]} ${year}`,s:{font:{bold:true,sz:12,color:{rgb:'FFFFFFFF'}},fill:{fgColor:{rgb:'FF0D0D1A'}},alignment:{horizontal:'center'}}},
    {v:'Trigramme',s:{font:{bold:true,color:{rgb:'FFFFFFFF'}},fill:{fgColor:{rgb:'FF0D0D1A'}},alignment:{horizontal:'center'}}},
    {v:'Catégorie',s:{font:{bold:true,color:{rgb:'FFFFFFFF'}},fill:{fgColor:{rgb:'FF0D0D1A'}},alignment:{horizontal:'center'}}},
  ];
  dates.forEach(d=>{
    const wd=d.getDay(); const di=wd===0?6:wd-1;
    const isW=wd===0||wd===6; const isH=isHol(fmt(d));
    const bg=isH?'FFB0BEC5':isW?'FFD0D0D0':'FF1A3A6B';
    const label=`${D3FR[di]}\n${d.getDate()}`;
    H.push({v:label,s:{font:{bold:true,color:{rgb:isW||isH?'FF424242':'FFFFFFFF'},sz:9},fill:{fgColor:{rgb:bg}},alignment:{horizontal:'center',vertical:'center',wrapText:true}}});
    H.push({v:'',s:{fill:{fgColor:{rgb:bg}}}});
  });
  const H2=[{v:'',s:{fill:{fgColor:{rgb:'FF0D0D1A'}}}},{v:'',s:{fill:{fgColor:{rgb:'FF0D0D1A'}}}},{v:'',s:{fill:{fgColor:{rgb:'FF0D0D1A'}}}},];
  dates.forEach(d=>{
    const wd=d.getDay(); const isW=wd===0||wd===6; const isH=isHol(fmt(d));
    const bg=isH?'FFB0BEC5':isW?'FFD0D0D0':'FF263A6B';
    ['AM','PM'].forEach(h=>H2.push({v:h,s:{font:{bold:true,sz:8,color:{rgb:'FFFFFFFF'}},fill:{fgColor:{rgb:bg}},alignment:{horizontal:'center'}}}));
  });

  const rows=[H,H2];
  emps.forEach(emp=>{
    const cat=CATS[emp.categorie]||{};
    const row=[
      {v:`${emp.prenom} ${emp.nom}`,s:{font:{bold:true,color:{rgb:'FFFFFFFF'}},fill:{fgColor:{rgb:'FF0D0D1A'}},alignment:{vertical:'center'}}},
      {v:emp.trigramme,s:{font:{bold:true,color:{rgb:'FFAABBDD'}},fill:{fgColor:{rgb:'FF0D0D1A'}},alignment:{horizontal:'center',vertical:'center'}}},
      {v:cat.lbl||emp.categorie,s:{font:{color:{rgb:'FF8899BB'}},fill:{fgColor:{rgb:'FF0D0D1A'}},alignment:{horizontal:'center',vertical:'center'}}},
    ];
    dates.forEach(d=>{
      const ds=fmt(d); const wd=d.getDay();
      const isW=wd===0||wd===6; const isH=isHol(ds);
      ['AM','PM'].forEach(half=>{
        const entry=S.planning[`${emp.id}_${ds}_${half}`]||{};
        const t=entry.type||(isH?'ferie':isW?'we':'');
        let txt='';
        if(t==='travail'&&entry.chantierId){const ch=S.chantiers.find(c=>c.id===entry.chantierId);txt=ch?ch.nom.slice(0,18):'';}
        else if(t==='conge')txt='Congé';
        else if(t==='maladie')txt='Maladie';
        else if(t==='formation')txt='Formation';
        else if(t==='absence')txt='Absence';
        else if(t==='deplacement')txt='Déplacement';
        else if(t==='ferie')txt='Férié';
        else if(t==='we')txt='W-E';
        let bg=TYPE_BG[t]||'FFFFFFFF';
        let fg=TYPE_FG[t]||'FF000000';
        if(t==='travail'&&entry.chantierId) bg=chanCol[entry.chantierId]||'FF4FC3F7';
        row.push({v:txt,s:{font:{sz:9,color:{rgb:fg}},fill:{fgColor:{rgb:bg}},alignment:{horizontal:'center',vertical:'center',wrapText:true},border:{top:{style:'thin',color:{rgb:'FFD0D0D0'}},bottom:{style:'thin',color:{rgb:'FFD0D0D0'}},left:{style:'thin',color:{rgb:'FFD0D0D0'}},right:{style:'thin',color:{rgb:'FFD0D0D0'}}}}});
      });
    });
    rows.push(row);
  });

  const ws=XLSX.utils.aoa_to_sheet(rows.map(r=>r.map(c=>typeof c==='object'?c.v:c)));
  rows.forEach((row,ri)=>row.forEach((cell,ci)=>{
    if(typeof cell==='object'&&cell.s){const addr=XLSX.utils.encode_cell({r:ri,c:ci});if(!ws[addr])ws[addr]={v:cell.v,t:'s'};ws[addr].s=cell.s;}
  }));
  ws['!cols']=[{wch:24},{wch:9},{wch:14},...Array(n*2).fill({wch:10})];
  ws['!rows']=rows.map((_,i)=>i===0?{hpt:30}:i===1?{hpt:14}:{hpt:20});
  ws['!merges']=[];
  dates.forEach((_,i)=>ws['!merges'].push({s:{r:0,c:3+i*2},e:{r:0,c:3+i*2+1}}));

  const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,`${MO[month].slice(0,3)} ${year}`);
  XLSX.writeFile(wb,`MARDAM_Master_${MO[month]}_${year}.xlsx`);
  toast(`Export Master ${MO[month]} ${year} téléchargé ✓`);
}

function exportMasterPDF(){
  // Génère une page print dédiée au master planning du mois en cours
  const year = S.masterYear;
  const month = S.masterMonth;
  const n = new Date(year, month+1, 0).getDate();
  const dates = Array.from({length:n}, (_,i) => new Date(year, month, i+1));
  const empF = document.getElementById('mp-emp')?.value||'';
  const emps = empF ? S.personnel.filter(p=>p.id===empF) : S.personnel;

  const TYPE_LBL = {travail:'T',conge:'C',maladie:'M',formation:'F',absence:'A',deplacement:'D',we:'',ferie:'Férié',''  :''};
  const TYPE_COLOR = {
    travail:'#1a3a6b',conge:'#0d4a2a',maladie:'#4a0d0d',
    formation:'#4a3a00',absence:'#4a2200',deplacement:'#2d0a4a',
    we:'#1a1a2a',ferie:'#3a2e00',''  :'#111827'
  };
  const TYPE_FG = {
    travail:'#82b1ff',conge:'#6effc4',maladie:'#ff9999',
    formation:'#ffe066',absence:'#ffb366',deplacement:'#d9a8ff',
    we:'#444466',ferie:'#ffd060',''  :'#333'
  };

  // Build table HTML
  const thCells = dates.map(d=>{
    const ds=fmt(d); const wd=d.getDay();
    const isW=wd===0||wd===6; const isH=isHol(ds);
    const di=wd===0?6:wd-1;
    const bg=isH?'#3a2e00':isW?'#1a1a2e':'#1a2540';
    const col=isH?'#ffd060':isW?'#555588':'#8898bb';
    return`<th style="background:${bg};color:${col};min-width:40px;padding:5px 2px;text-align:center;font-size:9px;border:1px solid #243050">
      <div>${D3[di]}</div><div style="font-size:13px;font-weight:800">${d.getDate()}</div>${isH?'<div style="font-size:8px;color:#ffd060;font-weight:700">Férié</div>':''}
    </th>`;
  }).join('');

  const bodyRows = emps.map(emp=>{
    const cat=CATS[emp.categorie]||{};
    const catColor={responsable:'#e040fb',chef:'#ff5e00',technicien:'#a88c6a',expert:'#2979ff',alternant:'#00e5b0',stagiaire:'#84fab0',interimaire:'#c084fc',prestataire:'#ffdd00'}[emp.categorie]||'#8898bb';
    const cells=dates.map(d=>{
      const ds=fmt(d);const wd=d.getDay();const isW=wd===0||wd===6;const isH=isHol(ds);
      const amK=`${emp.id}_${ds}_AM`;const pmK=`${emp.id}_${ds}_PM`;
      const am=S.planning[amK]||{};const pm=S.planning[pmK]||{};
      const at=am.type||'';const pt=pm.type||'';

      const cellBg=(t,entry)=>{
        if(t==='travail'&&entry.chantierId){const ch=S.chantiers.find(c=>c.id===entry.chantierId);if(ch?.color)return ch.color+'2a';}
        return TYPE_COLOR[t]||'#111827';
      };
      const cellFg=(t,entry)=>{
        if(t==='travail'&&entry.chantierId){const ch=S.chantiers.find(c=>c.id===entry.chantierId);if(ch?.color)return ch.color;}
        return TYPE_FG[t]||'#555';
      };
      const amLbl=at==='travail'&&am.chantierId?(S.chantiers.find(c=>c.id===am.chantierId)?.nom||'T').slice(0,5):TYPE_LBL[at]||'';
      const pmLbl=pt==='travail'&&pm.chantierId?(S.chantiers.find(c=>c.id===pm.chantierId)?.nom||'T').slice(0,5):TYPE_LBL[pt]||'';

      return`<td style="border:1px solid #1a2540;padding:0;min-width:40px">
        <div style="display:flex;flex-direction:column;height:44px">
          <div style="flex:1;background:${cellBg(at,am)};color:${cellFg(at,am)};display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700;border-bottom:1px solid #1a2540">${amLbl}</div>
          <div style="flex:1;background:${cellBg(pt,pm)};color:${cellFg(pt,pm)};display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700">${pmLbl}</div>
        </div>
      </td>`;
    }).join('');
    return`<tr>
      <td style="padding:4px 8px;white-space:nowrap;font-weight:700;font-size:11px;background:#0d1628;border:1px solid #1a2540;border-left:3px solid ${catColor}">
        ${emp.prenom} ${emp.nom}
      </td>
      <td style="padding:4px 6px;text-align:center;font-family:monospace;font-size:10px;font-weight:700;color:${catColor};background:#0d1628;border:1px solid #1a2540">${emp.trigramme}</td>
      ${cells}
    </tr>`;
  }).join('');

  // Legend
  const legendItems=[
    {col:'#1a3a6b',fg:'#82b1ff',lbl:'Travail'},{col:'#0d4a2a',fg:'#6effc4',lbl:'Congé'},
    {col:'#4a0d0d',fg:'#ff9999',lbl:'Maladie'},{col:'#4a3a00',fg:'#ffe066',lbl:'Formation'},
    {col:'#4a2200',fg:'#ffb366',lbl:'Absence'},{col:'#2d0a4a',fg:'#d9a8ff',lbl:'Déplacement'},
    {col:'#1a1a2e',fg:'#555588',lbl:'W-E'},{col:'#3a2e00',fg:'#ffd060',lbl:'Jour Férié'},
  ];
  const legendHtml=legendItems.map(i=>`<span style="display:inline-flex;align-items:center;gap:4px;margin-right:12px;font-size:10px;color:#8898bb">
    <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:${i.col};border:1px solid ${i.fg}"></span>${i.lbl}
  </span>`).join('');

  const html=`<!DOCTYPE html>
<!-- AeroStaff Pro v5 — Build 20260515051251 --><html><head><meta charset="UTF-8">
  <title>AeroStaff — Master Planning ${MO[month]} ${year}</title>
  <style>
    @page{size:A3 landscape;margin:12mm}
    body{font-family:'Outfit',Arial,sans-serif;background:#060a12;color:#f0f4ff;margin:0;padding:0;-webkit-print-color-adjust:exact;print-color-adjust:exact}
    table{border-collapse:collapse;width:100%}
    .header{display:flex;align-items:center;justify-content:space-between;padding:10px 0 14px;border-bottom:1px solid #243050;margin-bottom:12px}
    .title{font-size:22px;font-weight:800;letter-spacing:-0.5px}
    .title span{background:linear-gradient(90deg,#2979ff,#00d2ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .subtitle{font-size:12px;color:#8898bb;margin-top:2px}
    .legend{padding:8px 0 12px;display:flex;flex-wrap:wrap;gap:4px}
    @media print{body{background:#060a12!important}}
  </style></head>
  <body>
    <div class="header">
      <div>
        <div class="title">AeroStaff Pro — <span>Master Planning</span></div>
        <div class="subtitle">${MO[month]} ${year} · Exporté le ${new Date().toLocaleDateString('fr-FR')} · ${emps.length} employé(s)</div>
      </div>
      <div style="font-size:28px">✈️</div>
    </div>
    <div class="legend">${legendHtml}</div>
    <table>
      <thead><tr>
        <th style="background:#0d1628;color:#8898bb;padding:6px 10px;text-align:left;border:1px solid #243050;font-size:10px;white-space:nowrap">Personnel</th>
        <th style="background:#0d1628;color:#8898bb;padding:6px 6px;text-align:center;border:1px solid #243050;font-size:10px">TRI</th>
        ${thCells}
      </tr></thead>
      <tbody>${bodyRows}</tbody>
    </table>
    <div style="margin-top:10px;font-size:9px;color:#3a4a60;text-align:right">AeroStaff Pro · Généré le ${new Date().toLocaleString('fr-FR')}</div>
    <script>window.onload=()=>window.print()<\/script>
  
<!-- Footer copyright -->
<div id="copyright-footer" style="
  position:fixed;bottom:0;left:0;right:0;
  background:rgba(6,10,18,0.92);
  border-top:1px solid rgba(255,255,255,0.05);
  padding:4px 16px;
  display:flex;align-items:center;justify-content:center;
  font-size:9px;color:rgba(74,106,154,0.8);
  font-family:'JetBrains Mono',monospace;
  letter-spacing:0.8px;
  pointer-events:none;
  z-index:10;
  backdrop-filter:blur(8px);
">
  © 2025 Damien Campoy — MARDAM AeroDesk Pro · Tous droits réservés · Reproduction interdite
</div>
</body></html>`;

  const blob=new Blob([html],{type:'text/html'});
  const url=URL.createObjectURL(blob);
  const w=window.open(url,'_blank');
  if(!w) alert('Autorisez les popups pour générer le PDF.');
  setTimeout(()=>URL.revokeObjectURL(url),10000);
  toast(`PDF ${MO[month]} ${year} en cours de génération ✓`);
}




/* ═══ PROGRAMME ACTIVITÉ — GANTT ═══ */

// renderProgramme merged above

function renderGantt(containerId,legendId,chantiers,year){
  const el=document.getElementById(containerId);
  const legEl=document.getElementById(legendId);
  if(!chantiers.length){el.innerHTML='<div class="gantt-empty">Aucun chantier à afficher</div>';if(legEl)legEl.innerHTML='';return;}

  let minD=new Date(year,0,1),maxD=new Date(year,11,31);
  chantiers.forEach(c=>{
    if(c.debut){const d=parseLocal(c.debut);if(d<minD)minD=d;}
    if(c.fin){const d=parseLocal(c.fin);if(d>maxD)maxD=d;}
  });
  minD=new Date(minD.getFullYear(),minD.getMonth(),1);
  maxD=new Date(maxD.getFullYear(),maxD.getMonth()+1,0);
  const totalMs=maxD-minD;
  const pct=d=>Math.max(0,Math.min(100,(d-minD)/totalMs*100));

  const months=[];
  let cur=new Date(minD.getFullYear(),minD.getMonth(),1);
  while(cur<=maxD){months.push(new Date(cur));cur=new Date(cur.getFullYear(),cur.getMonth()+1,1);}

  const STATUT={
    encours:  {color:'#34c759', label:'En cours'},
    futur:    {color:'#34c759', label:'À venir'},
    termine:  {color:'#34c759', label:'Terminé'},
    prevision:{color:'#8e8e93', label:'Prévision'}
  };
  const MOS=['Jan','Fév','Mar','Avr','Mai','Jun','Jul','Aoû','Sep','Oct','Nov','Déc'];

  // Legend
  if(legEl){
    const used=[...new Set(chantiers.map(c=>c.statut))];
    legEl.innerHTML=used.map(s=>{const st=STATUT[s]||{color:'#888',label:s};return`<div style="display:flex;align-items:center;gap:5px;font-size:11px;color:var(--t2)"><div style="width:14px;height:10px;border-radius:3px;background:${st.color}"></div>${st.label}</div>`;}).join('');
  }

  const today=new Date();
  const todayPct=pct(today).toFixed(2);
  const showToday=today>=minD&&today<=maxD;

  const gridLines=months.map(m=>`<div class="gantt-grid-line" style="left:${pct(m).toFixed(2)}%"></div>`).join('');
  const todayLine=showToday?`<div class="gantt-today-line" style="left:${todayPct}%"></div>`:'';

  const sorted=[...chantiers].filter(c=>c.debut||c.fin).sort((a,b)=>{
    const da=a.debut?parseLocal(a.debut):new Date(9999,0,1);
    const db=b.debut?parseLocal(b.debut):new Date(9999,0,1);
    return da-db;
  });

  const rows=sorted.map(c=>{
    const st=STATUT[c.statut]||{color:'#34c759'};
    const barColor=st.color;
    const textColor='#fff';
    const startD=c.debut?parseLocal(c.debut):minD;
    const endD=c.fin?parseLocal(c.fin):maxD;
    const cs=startD<minD?minD:startD;
    const ce=endD>maxD?maxD:endD;
    const l=pct(cs).toFixed(2);
    const w=Math.max(0.5,pct(ce)-pct(cs)).toFixed(2);
    const dateRange=[c.debut?disp(c.debut):'',c.fin?disp(c.fin):''].filter(Boolean).join(' → ');

    return`<div class="gantt-row">
      <div class="gantt-row-label">
        <div class="gantt-row-name" title="${c.nom}" style="border-left:3px solid ${barColor};padding-left:7px">${c.nom}</div>
        ${dateRange?`<div class="gantt-row-meta">📅 ${dateRange}</div>`:''}
      </div>
      <div class="gantt-timeline">
        ${gridLines}${todayLine}
        <div class="gantt-bar" style="left:${l}%;width:${w}%;background:${barColor};color:${textColor}"
          title="${c.nom}${c.debut?' | '+disp(c.debut):''}${c.fin?' → '+disp(c.fin):''}">
          ${parseFloat(w)>3?`${disp(c.debut)}${c.fin?' → '+disp(c.fin):''}`:'' }
        </div>
      </div>
    </div>`;
  }).join('');

  const monthHeader=months.map(m=>{
    const w=Math.max(0,pct(new Date(m.getFullYear(),m.getMonth()+1,1))-pct(m)).toFixed(2);
    return`<div class="gantt-month-cell" style="flex:none;width:${w}%;min-width:0">${MOS[m.getMonth()]}${months.length<=14?' '+m.getFullYear():''}</div>`;
  }).join('');

  el.innerHTML=`<div class="gantt-wrap">
    <div class="gantt-header">
      <div class="gantt-label-col">Chantier</div>
      <div class="gantt-months">${monthHeader}</div>
    </div>
    ${rows||'<div class="gantt-empty">Aucune date renseignée sur les chantiers</div>'}
    ${showToday?`<div style="font-size:10px;color:var(--rose);margin-top:6px;padding-left:200px">▲ Aujourd'hui : ${today.toLocaleDateString('fr-FR')}</div>`:''}
  </div>`;
}

function isLightHex(hex){
  if(!hex||!hex.startsWith('#'))return false;
  const r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16);
  return(r*299+g*587+b*114)/1000>150;
}

function exportGanttPDF(){
  const year=parseInt(document.getElementById('gantt-year')?.value)||new Date().getFullYear();
  const MOS=['Jan','Fév','Mar','Avr','Mai','Jun','Jul','Aoû','Sep','Oct','Nov','Déc'];
  const STATUT_COLOR={encours:'#34c759',futur:'#34c759',termine:'#34c759',prevision:'#8e8e93'};

  function buildSection(chantiers,title){
    if(!chantiers.length) return`<p style="color:#999;padding:10px">Aucun chantier</p>`;
    let minD=new Date(year,0,1),maxD=new Date(year,11,31);
    chantiers.forEach(c=>{if(c.debut){const d=parseLocal(c.debut);if(d<minD)minD=d;}if(c.fin){const d=parseLocal(c.fin);if(d>maxD)maxD=d;}});
    minD=new Date(minD.getFullYear(),minD.getMonth(),1);
    maxD=new Date(maxD.getFullYear(),maxD.getMonth()+1,0);
    const totalMs=maxD-minD;const pct=d=>Math.max(0,Math.min(100,(d-minD)/totalMs*100));
    const months=[];let cur=new Date(minD.getFullYear(),minD.getMonth(),1);
    while(cur<=maxD){months.push(new Date(cur));cur=new Date(cur.getFullYear(),cur.getMonth()+1,1);}
    const mHead=months.map(m=>{const w=Math.max(0,pct(new Date(m.getFullYear(),m.getMonth()+1,1))-pct(m)).toFixed(1);return`<div style="flex:none;width:${w}%;text-align:center;font-size:8px;font-weight:700;color:#888;overflow:hidden">${MOS[m.getMonth()]}</div>`;}).join('');
    const rows=[...chantiers].filter(c=>c.debut||c.fin).sort((a,b)=>{const da=a.debut?parseLocal(a.debut):new Date(9999,0,1);const db=b.debut?parseLocal(b.debut):new Date(9999,0,1);return da-db;}).map(c=>{
      const bc=c.color||STATUT_COLOR[c.statut]||'#555';const tc=isLightHex(bc)?'#000':'#fff';
      const s=c.debut?parseLocal(c.debut):minD;const e=c.fin?parseLocal(c.fin):maxD;
      const cs=s<minD?minD:s;const ce=e>maxD?maxD:e;
      const l=pct(cs).toFixed(1);const w=Math.max(0.5,pct(ce)-pct(cs)).toFixed(1);
      const resp=byId(c.resp);const chef=byId(c.chef);
      const ressStr=c.ressources&&Object.keys(c.ressources).length?Object.entries(c.ressources).map(([k,v])=>`${v} ${CATS[k]?.lbl||k}`).join(', '):'';
      return`<tr>
        <td style="padding:5px 8px;font-size:9px;font-weight:700;border-bottom:1px solid #f0f0f0;max-width:160px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;border-left:3px solid ${bc}">${c.nom}</td>
        <td style="padding:3px 0;border-bottom:1px solid #f0f0f0">
          <div style="position:relative;height:22px;background:#f5f5f5;border-radius:4px">
            ${months.map(m=>`<div style="position:absolute;left:${pct(m).toFixed(1)}%;top:0;bottom:0;width:1px;background:#e8e8e8"></div>`).join('')}
            <div style="position:absolute;left:${l}%;width:${w}%;height:100%;background:${bc};border-radius:4px;overflow:hidden;display:flex;align-items:center;padding:0 4px${c.statut==='termine'?';opacity:.5':''}">
              <span style="font-size:7px;font-weight:700;color:${tc};white-space:nowrap">${parseFloat(w)>6?c.nom.slice(0,25):''}</span>
            </div>
          </div>
        </td>
        <td style="padding:5px 8px;font-size:8px;color:#666;border-bottom:1px solid #f0f0f0;white-space:nowrap">${c.debut?disp(c.debut):'—'}</td>
        <td style="padding:5px 8px;font-size:8px;color:#666;border-bottom:1px solid #f0f0f0;white-space:nowrap">${c.fin?disp(c.fin):'—'}</td>
        <td style="padding:5px 8px;font-size:8px;color:#555;border-bottom:1px solid #f0f0f0">${ressStr||'—'}</td>
      </tr>`;
    }).join('');
    return`<h3 style="font-size:13px;font-weight:800;margin:0 0 10px;color:#1a1a2e;padding-bottom:6px;border-bottom:2px solid #1a1a2e">${title}</h3>
    <table style="width:100%;border-collapse:collapse">
      <thead><tr>
        <th style="width:160px;padding:5px 8px;font-size:8px;font-weight:700;text-align:left;color:#888;border-bottom:2px solid #ddd">Chantier</th>
        <th style="padding:5px 0;border-bottom:2px solid #ddd"><div style="display:flex">${mHead}</div></th>
        <th style="width:90px;padding:5px 8px;font-size:8px;font-weight:700;color:#888;border-bottom:2px solid #ddd">Début</th>
        <th style="width:90px;padding:5px 8px;font-size:8px;font-weight:700;color:#888;border-bottom:2px solid #ddd">Fin prévue</th>
        <th style="width:140px;padding:5px 8px;font-size:8px;font-weight:700;color:#888;border-bottom:2px solid #ddd">Ressources</th>
      </tr></thead>
      <tbody>${rows}</tbody>
    </table>`;
  }

  const html=`<!DOCTYPE html>
<!-- AeroStaff Pro v5 — Build 20260515051251 --><html><head><meta charset="UTF-8"><title>Programme Activité ${year}</title>
  <style>@page{size:A3 landscape;margin:12mm}body{font-family:Arial,sans-serif;background:#fff;color:#1a1a2e;-webkit-print-color-adjust:exact;print-color-adjust:exact}.section{margin-bottom:24px;padding:14px;border:1px solid #e8e8e8;border-radius:6px}</style>
  </head><body>
    <div style="display:flex;align-items:center;justify-content:space-between;padding-bottom:10px;border-bottom:2px solid #1a1a2e;margin-bottom:16px">
      <div><div style="font-size:20px;font-weight:900">✈ AeroStaff Pro — Programme Activité ${year}</div>
      <div style="font-size:10px;color:#888;margin-top:2px">Exporté le ${new Date().toLocaleDateString('fr-FR')}</div></div>
      <div style="font-size:32px">📊</div>
    </div>
    <div class="section">${buildSection(S.chantiers.filter(c=>['encours','futur','termine'].includes(c.statut)),'🔧 Chantiers — En cours · À venir · Terminés')}</div>
    ${S.chantiers.some(c=>c.statut==='prevision')?`<div class="section">${buildSection(S.chantiers.filter(c=>c.statut==='prevision'),'🔮 Chantiers Prévisionnels')}</div>`:''}
    <script>window.onload=()=>window.print()<\/script>
  
<!-- Footer copyright -->
<div id="copyright-footer" style="
  position:fixed;bottom:0;left:0;right:0;
  background:rgba(6,10,18,0.92);
  border-top:1px solid rgba(255,255,255,0.05);
  padding:4px 16px;
  display:flex;align-items:center;justify-content:center;
  font-size:9px;color:rgba(74,106,154,0.8);
  font-family:'JetBrains Mono',monospace;
  letter-spacing:0.8px;
  pointer-events:none;
  z-index:10;
  backdrop-filter:blur(8px);
">
  © 2025 Damien Campoy — MARDAM AeroDesk Pro · Tous droits réservés · Reproduction interdite
</div>
</body></html>`;

  const blob=new Blob([html],{type:'text/html'});
  const url=URL.createObjectURL(blob);
  const w=window.open(url,'_blank');
  if(!w)alert('Autorisez les popups pour générer le PDF.');
  setTimeout(()=>URL.revokeObjectURL(url),10000);
  toast('Export Programme Activité en cours ✓');
}

function exportAll(){
  const blob=new Blob([JSON.stringify({...S,weekStart:S.weekStart?.toISOString()},null,2)],{type:'application/json'});
  const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=`AeroStaff_${fmt(new Date())}.json`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);
}
function handleJsonImport(e){
  const file=e.target.files[0];if(!file)return;
  const reader=new FileReader();
  reader.onload=ev=>{try{if(!confirm('Remplacer toutes les données ?'))return;const p=JSON.parse(ev.target.result);S={...S,...p};if(p.weekStart)S.weekStart=new Date(p.weekStart);save();location.reload();}catch(err){alert('Fichier invalide : '+err.message);}};
  reader.readAsText(file);e.target.value='';
}

/* ═══ GOOGLE DRIVE via Google Apps Script ═══ */
// State stored in S.gdrive: { connected, gasUrl, lastSync, lastPushOk }

function openDriveModal(){
  const conn = S.gdrive?.connected && S.gdrive?.gasUrl;
  document.getElementById('gasNotConf').style.display = conn ? 'none' : 'block';
  document.getElementById('gasConf').style.display    = conn ? 'block' : 'none';
  if(conn){
    document.getElementById('gasLastSync').textContent =
      S.gdrive.lastSync ? new Date(S.gdrive.lastSync).toLocaleString('fr-FR') : 'Jamais';
    document.getElementById('gasSyncStatus').textContent =
      S.gdrive.lastPushOk === false ? '⚠ Erreur dernière sync' : '✓ OK';
    document.getElementById('gasSyncStatus').style.color =
      S.gdrive.lastPushOk === false ? 'var(--rose)' : 'var(--mint)';
  } else {
    if(S.gdrive?.gasUrl) document.getElementById('gasUrl').value = S.gdrive.gasUrl;
  }
}

function driveTab(tab, el){
  document.querySelectorAll('#m-drive .ftab').forEach(b=>b.classList.remove('on'));
  el.classList.add('on');
  document.getElementById('driveTabAuto').style.display   = tab==='auto'   ? 'block' : 'none';
  document.getElementById('driveTabManual').style.display = tab==='manual' ? 'block' : 'none';
}

function copyGasCode(){
  const code = document.getElementById('gasCode').textContent;
  navigator.clipboard.writeText(code).then(()=>toast('Code copié dans le presse-papiers ✓'))
    .catch(()=>{ /* fallback */ const ta=document.createElement('textarea');ta.value=code;document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();toast('Code copié ✓'); });
}

async function connectGAS(){
  const url = document.getElementById('gasUrl').value.trim();
  if(!url || !url.includes('script.google.com')){
    alert('⚠️ URL invalide.\nL\'URL doit commencer par https://script.google.com/macros/s/...');
    return;
  }
  toast('Test de connexion...');
  document.querySelector('#gasNotConf .btn-cyan').textContent = '⏳ Connexion...';
  document.querySelector('#gasNotConf .btn-cyan').disabled = true;

  try {
    // Test GET — récupère les données existantes ou {}
    const r = await fetch(url, {method:'GET', redirect:'follow'});
    if(!r.ok) throw new Error(`HTTP ${r.status}`);
    const text = await r.text();
    // Vérifie que c'est du JSON valide
    JSON.parse(text);

    // Connexion OK — sauvegarde l'URL
    if(!S.gdrive) S.gdrive = {};
    S.gdrive.gasUrl    = url;
    S.gdrive.connected = true;
    S.gdrive.lastPushOk = true;
    save();

    // Si données distantes non vides, propose de les récupérer
    if(text !== '{}' && text.trim().length > 10){
      const merge = confirm('✅ Connexion réussie !\n\nDes données existent déjà dans Google Drive.\nVeux-tu les récupérer ? (Oui = écrase les données locales · Non = garde les données locales)');
      if(merge){ await gasPullData(url); }
      else { await gasPushData(url); }
    } else {
      // Aucune donnée distante → pousse les données locales
      await gasPushData(url);
    }

    updateDriveUI();
    openDriveModal(); // refresh view
    toast('Google Drive connecté et synchronisé ✓');

  } catch(err){
    document.querySelector('#gasNotConf .btn-cyan').textContent = '⚡ Connecter à Google Drive';
    document.querySelector('#gasNotConf .btn-cyan').disabled = false;
    alert('❌ Connexion échouée :\n' + err.message + '\n\nVérifie que :\n• L\'URL est bien celle du déploiement\n• Le script est déployé en accès "Tout le monde"\n• Tu as bien autorisé les permissions lors du déploiement');
  }
}

async function gasPushData(url){
  url = url || S.gdrive?.gasUrl;
  if(!url) return;
  const payload = JSON.stringify({...S, weekStart: S.weekStart?.toISOString()});
  try {
    const r = await fetch(url, {
      method: 'POST',
      body: payload,
      headers: {'Content-Type':'text/plain'}, // GAS accepte text/plain
      redirect: 'follow'
    });
    const text = await r.text();
    let ok = r.ok;
    try { const j=JSON.parse(text); ok = j.ok !== false; } catch(e){}
    S.gdrive.lastSync    = new Date().toISOString();
    S.gdrive.lastPushOk  = ok;
    save();
    updateDriveUI();
  } catch(err){
    S.gdrive.lastPushOk = false;
    save();
    console.warn('GAS push error:', err);
  }
}

async function gasPullData(url){
  url = url || S.gdrive?.gasUrl;
  if(!url) return;
  try {
    const r = await fetch(url, {method:'GET', redirect:'follow'});
    if(!r.ok) throw new Error(`HTTP ${r.status}`);
    const text = await r.text();
    if(!text || text === '{}') return;
    const remote = JSON.parse(text);
    const merged = {...S, ...remote};
    if(remote.weekStart) merged.weekStart = new Date(remote.weekStart);
    S = merged;
    _safeStorage.setItem('asp4', JSON.stringify(S));
    location.reload();
  } catch(err){
    alert('❌ Récupération échouée : ' + err.message);
  }
}

// Boutons du panel "connecté"
function gasPush(){
  toast('Sauvegarde en cours...');
  gasPushData().then(()=>{
    document.getElementById('gasLastSync').textContent = new Date().toLocaleString('fr-FR');
    toast('Sauvegardé dans Google Drive ✓');
  });
}
function gasPull(){
  if(!confirm('Récupérer les données depuis Google Drive ?\nCela va remplacer les données locales actuelles.')) return;
  toast('Récupération en cours...');
  gasPullData();
}
function disconnectGAS(){
  if(!confirm('Déconnecter Google Drive ?\nLes données locales sont conservées.')) return;
  S.gdrive = {connected:false, gasUrl:'', lastSync:null, lastPushOk:null};
  save(); updateDriveUI(); openDriveModal();
  toast('Google Drive déconnecté');
}

// Sync auto — 4 secondes après chaque save()
let driveTimer = null;
function schedDriveSync(){
  if(!S.gdrive?.connected || !S.gdrive?.gasUrl) return;
  if(driveTimer) clearTimeout(driveTimer);
  driveTimer = setTimeout(()=>gasPushData(), 4000);
}

function updateDriveUI(){
  const dot = document.getElementById('driveDot');
  const lbl = document.getElementById('driveLbl');
  const conn = S.gdrive?.connected && S.gdrive?.gasUrl;
  if(conn){
    dot.className = S.gdrive.lastPushOk === false ? 'drive-dot busy' : 'drive-dot ok';
    lbl.textContent = 'Drive sync';
  } else {
    dot.className = 'drive-dot';
    lbl.textContent = 'Google Drive';
  }
}


/* ═══ MODALS ═══ */
function openM(id){document.getElementById(id).classList.add('on');if(id==='m-hol')renderHolTags();if(id==='m-drive')openDriveModal();}
function closeM(id){document.getElementById(id).classList.remove('on');}
document.querySelectorAll('.mbg').forEach(bg=>{bg.addEventListener('click',e=>{if(e.target===bg)bg.classList.remove('on');});});

/* ═══ TOAST ═══ */
let toastTmr;
function toast(msg){const el=document.getElementById('toastEl');document.getElementById('toastMsg').textContent=msg;el.classList.add('show');if(toastTmr)clearTimeout(toastTmr);toastTmr=setTimeout(()=>el.classList.remove('show'),2800);}

/* ═══ LEGEND CSS injection ═══ */
/* Inject computed styles for legend dots */
(function injectLegendCSS(){
  const cssMap={ht:'rgba(41,121,255,0.25)',hco:'rgba(0,229,176,0.2)',hm:'rgba(255,77,109,0.2)',hfo:'rgba(255,208,96,0.22)',hab:'rgba(255,154,60,0.2)',hdp:'rgba(192,132,252,0.2)',hwe:'rgba(255,255,255,0.05)',hfe:'rgba(255,208,96,0.1)'};
  const style=document.createElement('style');
  style.textContent=Object.entries(cssMap).map(([cls,bg])=>`.leg-dot.${cls}{background:${bg}}`).join('\n');
  document.head.appendChild(style);
})();

