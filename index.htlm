<style>
/* ═══════════════════════════════════════════
   DESIGN SYSTEM — Glassmorphism Dark Premium
═══════════════════════════════════════════ */
:root {
  /* Base */
  --bg0: #060a12;
  --bg1: #0a1020;
  --bg2: #0e1628;
  --bg3: #121e32;

  /* Glass */
  --glass-1: rgba(255,255,255,0.04);
  --glass-2: rgba(255,255,255,0.07);
  --glass-3: rgba(255,255,255,0.10);
  --glass-border: rgba(255,255,255,0.08);
  --glass-border-bright: rgba(255,255,255,0.15);

  /* Accents */
  --cyan:   #00d2ff;
  --blue:   #2979ff;
  --mint:   #00e5b0;
  --gold:   #ffd060;
  --rose:   #ff4d6d;
  --purple: #c084fc;
  --orange: #ff9a3c;
  --lime:   #84fab0;

  /* Text */
  --t1: #f0f4ff;
  --t2: #a8b8d8;
  --t3: #5a7090;
  --t4: #2e4060;

  /* Status */
  --ok:   #00e5b0;
  --warn: #ffd060;
  --err:  #ff4d6d;
  --na:   #5a7090;

  /* Staff colors */
  --chef:      #ff5e00;
  --responsable: #e040fb;
  --tech:      #a88c6a;
  --expert:    #2979ff;
  --alt:       #00e5b0;
  --stag:      #84fab0;
  --interim:   #c084fc;
  --prestataire: #ffdd00;

  /* Radii */
  --r4:  4px; --r8: 8px; --r12: 12px;
  --r16: 16px; --r20: 20px; --r24: 24px;

  /* Shadows */
  --sh-sm: 0 2px 8px rgba(0,0,0,0.3);
  --sh-md: 0 8px 32px rgba(0,0,0,0.4);
  --sh-lg: 0 20px 60px rgba(0,0,0,0.5);
  --sh-glow-cyan:   0 0 24px rgba(0,210,255,0.15);
  --sh-glow-blue:   0 0 20px rgba(41,121,255,0.2);
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;background:var(--bg0)}
body{font-family:'Outfit',sans-serif;color:var(--t1);display:flex;flex-direction:column;-webkit-font-smoothing:antialiased}

/* Background mesh */
body::before{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background:
    radial-gradient(ellipse 80% 60% at 20% -10%, rgba(41,121,255,0.12) 0%, transparent 60%),
    radial-gradient(ellipse 60% 50% at 80% 110%, rgba(0,210,255,0.08) 0%, transparent 60%),
    radial-gradient(ellipse 40% 40% at 50% 50%, rgba(192,132,252,0.04) 0%, transparent 70%);
}

::-webkit-scrollbar{width:3px;height:3px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.1);border-radius:99px}

/* ═══ HEADER ═══ */
.header{
  position:relative;z-index:100;
  background:rgba(8,12,20,0.8);
  backdrop-filter:blur(24px) saturate(180%);
  -webkit-backdrop-filter:blur(24px) saturate(180%);
  border-bottom:1px solid var(--glass-border);
  padding:0 20px;flex-shrink:0;
}
.header-inner{
  display:flex;align-items:center;gap:14px;
  height:62px;max-width:1700px;margin:0 auto;
}

/* Logo */
.logo{display:flex;align-items:center;gap:11px;cursor:pointer;flex-shrink:0;text-decoration:none}
.logo-icon{
  width:40px;height:40px;border-radius:12px;flex-shrink:0;
  background:linear-gradient(135deg,#2979ff 0%,#00d2ff 100%);
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 4px 16px rgba(0,210,255,0.3);
  position:relative;overflow:hidden;
}
.logo-icon::before{
  content:'';position:absolute;inset:-50%;
  background:conic-gradient(from 0deg,transparent 270deg,rgba(255,255,255,0.2) 360deg);
  animation:spin 4s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}
.logo-icon svg{position:relative;z-index:1}
.logo-words{display:flex;flex-direction:column;line-height:1}
.logo-name{font-size:18px;font-weight:800;letter-spacing:-0.5px;
  background:linear-gradient(90deg,#ffffff,#a8d8ff);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.logo-sub{font-size:10px;color:var(--t3);font-weight:500;letter-spacing:1.5px;text-transform:uppercase;margin-top:1px}

.hspacer{flex:1}
.header-right{display:flex;align-items:center;gap:8px}

/* Pill buttons */
.hbtn{
  height:32px;padding:0 14px;border-radius:99px;border:none;cursor:pointer;
  font-family:'Outfit',sans-serif;font-size:12px;font-weight:600;
  display:inline-flex;align-items:center;gap:6px;transition:all .2s;
  white-space:nowrap;letter-spacing:0.2px;
}
.hbtn:active{transform:scale(.95)}
.hbtn-ghost{background:var(--glass-1);border:1px solid var(--glass-border);color:var(--t2)}
.hbtn-ghost:hover{background:var(--glass-2);border-color:var(--glass-border-bright);color:var(--t1)}
.hbtn-primary{background:linear-gradient(135deg,#2979ff,#00d2ff);color:#fff;box-shadow:var(--sh-glow-blue)}
.hbtn-primary:hover{box-shadow:var(--sh-glow-cyan);filter:brightness(1.1)}

/* Alert pill */
.alert-pill{
  height:28px;padding:0 12px;border-radius:99px;
  background:rgba(255,77,109,0.15);border:1px solid rgba(255,77,109,0.3);
  color:var(--rose);font-size:11px;font-weight:700;
  display:none;align-items:center;gap:5px;
  animation:throb 2s infinite;
}
.alert-pill.on{display:flex}
@keyframes throb{0%,100%{opacity:1}50%{opacity:.65}}

/* Drive indicator */
.drive-pill{
  height:28px;padding:0 12px;border-radius:99px;cursor:pointer;
  background:var(--glass-1);border:1px solid var(--glass-border);
  font-size:11px;font-weight:600;color:var(--t3);
  display:flex;align-items:center;gap:6px;transition:all .2s;
}
.drive-pill:hover{border-color:var(--cyan);color:var(--cyan)}
.drive-dot{width:7px;height:7px;border-radius:50%;background:var(--t4);flex-shrink:0;transition:background .3s}
.drive-dot.ok{background:var(--mint);box-shadow:0 0 6px var(--mint)}
.drive-dot.busy{background:var(--gold);animation:throb .8s infinite}

/* ═══ TABS ═══ */
.tabbar{
  position:relative;z-index:99;flex-shrink:0;
  background:rgba(10,16,32,0.7);
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid var(--glass-border);
  overflow-x:auto;scrollbar-width:none;
}
.tabbar::-webkit-scrollbar{display:none}
.tab-scroll{display:flex;max-width:1700px;margin:0 auto;padding:0 16px;position:relative}

.tab{
  background:none;border:none;border-bottom:2px solid transparent;
  padding:13px 18px;cursor:pointer;color:var(--t3);
  font-family:'Outfit',sans-serif;font-size:12.5px;font-weight:600;
  letter-spacing:0.3px;white-space:nowrap;
  display:flex;align-items:center;gap:6px;transition:all .2s;
  position:relative;
}
.tab:hover{color:var(--t2)}
.tab.active{color:var(--cyan);border-bottom-color:var(--cyan)}
.tab-notif{
  width:6px;height:6px;border-radius:50%;background:var(--rose);
  position:absolute;top:9px;right:10px;display:none;
  animation:throb 1.5s infinite;
}
.tab-notif.on{display:block}

/* ═══ BODY ═══ */
.body{flex:1;overflow-y:auto;overflow-x:hidden;position:relative;z-index:1}
.page{display:none;max-width:1700px;margin:0 auto;padding:22px 18px}
.page.on{display:block}

/* ═══ SECTION HEAD ═══ */
.sh{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:10px}
.sh-title{font-size:28px;font-weight:800;letter-spacing:-0.8px}
.sh-title em{font-style:normal;
  background:linear-gradient(90deg,var(--cyan),var(--blue));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.btn-row{display:flex;gap:7px;flex-wrap:wrap;align-items:center}

/* ═══ GLASS CARD ═══ */
.gc{
  background:var(--glass-1);
  border:1px solid var(--glass-border);
  border-radius:var(--r20);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  overflow:hidden;margin-bottom:14px;
  transition:border-color .2s;
}
.gc:hover{border-color:var(--glass-border-bright)}
.gc-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:16px 20px 14px;
  border-bottom:1px solid var(--glass-border);
  gap:10px;flex-wrap:wrap;
}
.gc-title{
  font-size:13px;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;
  color:var(--t2);display:flex;align-items:center;gap:8px;
}
.gc-body{padding:18px 20px}

/* ═══ STATS GRID ═══ */
.stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;margin-bottom:14px}
.st{
  background:var(--glass-1);border:1px solid var(--glass-border);
  border-radius:var(--r16);padding:18px 16px;text-align:center;
  position:relative;overflow:hidden;cursor:default;transition:all .2s;
}
.st::after{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  border-radius:2px 2px 0 0;
}
.st.c-cyan::after{background:linear-gradient(90deg,var(--blue),var(--cyan))}
.st.c-gold::after{background:linear-gradient(90deg,var(--orange),var(--gold))}
.st.c-rose::after{background:linear-gradient(90deg,var(--rose),#ff8fab)}
.st.c-mint::after{background:linear-gradient(90deg,var(--mint),var(--lime))}
.st.c-purple::after{background:linear-gradient(90deg,var(--blue),var(--purple))}
.st.c-orange::after{background:linear-gradient(90deg,var(--orange),var(--gold))}
.st:hover{transform:translateY(-2px);box-shadow:var(--sh-md);border-color:var(--glass-border-bright)}
.st-val{
  font-size:38px;font-weight:900;line-height:1;letter-spacing:-2px;
  font-variant-numeric:tabular-nums;margin-bottom:6px;
  background:linear-gradient(135deg,#fff,rgba(255,255,255,0.7));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.st-lbl{font-size:11px;color:var(--t3);font-weight:600;letter-spacing:0.5px;text-transform:uppercase}

/* ═══ ALERT ROWS ═══ */
.alert-list{display:flex;flex-direction:column}
.al{
  display:flex;align-items:flex-start;gap:12px;
  padding:13px 20px;border-bottom:1px solid var(--glass-border);
  transition:background .15s;
}
.al:last-child{border-bottom:none}
.al:hover{background:var(--glass-1)}
.al-ico{
  width:34px;height:34px;border-radius:10px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;font-size:16px;
}
.al-ico.red{background:rgba(255,77,109,0.15)}
.al-ico.gold{background:rgba(255,208,96,0.15)}
.al-ico.blue{background:rgba(41,121,255,0.12)}
.al-body{flex:1;min-width:0}
.al-title{font-size:13px;font-weight:700;color:var(--t1)}
.al-sub{font-size:11px;color:var(--t3);margin-top:2px;line-height:1.4}

/* ═══ BUTTONS ═══ */
.btn{
  height:36px;padding:0 18px;border-radius:99px;border:none;cursor:pointer;
  font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;
  display:inline-flex;align-items:center;gap:6px;transition:all .18s;
  letter-spacing:0.2px;white-space:nowrap;
}
.btn:active{transform:scale(.95)}
.btn-cyan{background:linear-gradient(135deg,#2979ff,#00d2ff);color:#000;box-shadow:var(--sh-glow-cyan)}
.btn-cyan:hover{filter:brightness(1.1);box-shadow:0 0 32px rgba(0,210,255,0.3)}
.btn-mint{background:linear-gradient(135deg,var(--mint),var(--lime));color:#000}
.btn-rose{background:rgba(255,77,109,0.2);border:1px solid rgba(255,77,109,0.3);color:var(--rose)}
.btn-rose:hover{background:rgba(255,77,109,0.3)}
.btn-ghost{background:var(--glass-2);border:1px solid var(--glass-border);color:var(--t2)}
.btn-ghost:hover{background:var(--glass-3);border-color:var(--glass-border-bright);color:var(--t1)}
.btn-gold{background:linear-gradient(135deg,var(--orange),var(--gold));color:#000}
.btn-sm{height:30px;padding:0 13px;font-size:12px}
.btn-xs{height:26px;padding:0 10px;font-size:11px;border-radius:8px}

/* ═══ BADGES ═══ */
.badge{
  display:inline-flex;align-items:center;padding:3px 9px;border-radius:99px;
  font-size:10.5px;font-weight:700;font-family:'JetBrains Mono',monospace;
  letter-spacing:0.3px;
}
.bv{background:rgba(0,229,176,0.12);color:var(--mint);border:1px solid rgba(0,229,176,0.25)}
.bw{background:rgba(255,208,96,0.12);color:var(--gold);border:1px solid rgba(255,208,96,0.25)}
.be{background:rgba(255,77,109,0.12);color:var(--rose);border:1px solid rgba(255,77,109,0.25)}
.bn{background:rgba(90,112,144,0.15);color:var(--t3);border:1px solid var(--glass-border)}
.b-chef{background:rgba(255,94,0,0.15);color:var(--chef);border:1px solid rgba(255,94,0,0.4)}
.b-resp{background:rgba(224,64,251,0.12);color:var(--responsable);border:1px solid rgba(224,64,251,0.3)}
.b-tech{background:rgba(168,140,106,0.12);color:var(--tech);border:1px solid rgba(168,140,106,0.25)}
.b-exp{background:rgba(41,121,255,0.12);color:#82b1ff;border:1px solid rgba(41,121,255,0.25)}
.b-alt{background:rgba(0,229,176,0.12);color:var(--alt);border:1px solid rgba(0,229,176,0.25)}
.b-stag{background:rgba(132,250,176,0.12);color:var(--stag);border:1px solid rgba(132,250,176,0.25)}
.b-int{background:rgba(192,132,252,0.12);color:var(--purple);border:1px solid rgba(192,132,252,0.25)}
.sc.interimaire.inactif{opacity:0.45;filter:grayscale(0.6)}
.sc.interimaire.inactif::before{background:linear-gradient(90deg,#555,#777)}
.toggle-actif{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:99px;font-size:11px;font-weight:700;cursor:pointer;border:none;transition:all .2s}
.toggle-actif.on{background:rgba(52,199,89,0.15);color:#34c759;border:1px solid rgba(52,199,89,0.35)}
.toggle-actif.off{background:rgba(255,255,255,0.06);color:var(--t4);border:1px solid rgba(255,255,255,0.1)}
.b-prest{background:rgba(255,221,0,0.15);color:var(--prestataire);border:1px solid rgba(255,221,0,0.4)}

/* ═══ FORMS ═══ */
.fgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:11px;margin-bottom:14px}
.field{display:flex;flex-direction:column;gap:5px}
.field label{font-size:11px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:0.7px}
input,select,textarea{
  background:rgba(255,255,255,0.05);border:1px solid var(--glass-border);
  border-radius:var(--r12);color:var(--t1);padding:10px 13px;
  font-size:13.5px;font-family:'Outfit',sans-serif;
  outline:none;transition:all .2s;width:100%;
  -webkit-appearance:none;appearance:none;
}
input:focus,select:focus,textarea:focus{
  border-color:var(--cyan);background:rgba(0,210,255,0.05);
  box-shadow:0 0 0 3px rgba(0,210,255,0.1);
}
input::placeholder{color:var(--t4)}
select option{background:#0e1628;color:var(--t1)}
textarea{resize:vertical;min-height:64px}
input[type=color]{padding:4px 8px;height:40px;cursor:pointer}
input[type=date]::-webkit-calendar-picker-indicator{filter:invert(0.5) brightness(2)}

/* ═══ TABLE ═══ */
.tscroll{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13px}
thead th{
  background:rgba(255,255,255,0.03);color:var(--t3);
  font-size:10.5px;font-weight:700;text-transform:uppercase;
  letter-spacing:0.8px;padding:10px 14px;text-align:left;
  border-bottom:1px solid var(--glass-border);
  white-space:nowrap;position:sticky;top:0;z-index:2;
}
tbody tr{border-bottom:1px solid rgba(255,255,255,0.04);transition:background .12s}
tbody tr:last-child{border-bottom:none}
tbody tr:hover{background:var(--glass-1)}
tbody td{padding:11px 14px;color:var(--t1);vertical-align:middle}

/* ═══ PLANNING GRID ═══ */
.pscroll{overflow-x:auto;border-radius:var(--r12)}
.ptable{border-collapse:collapse;min-width:600px;width:100%;font-size:11px}
.ptable th{
  background:rgba(255,255,255,0.04);color:var(--t3);
  padding:8px 4px;text-align:center;font-size:10px;
  font-weight:700;letter-spacing:0.5px;min-width:54px;
  border:1px solid rgba(255,255,255,0.05);
  position:sticky;top:0;z-index:2;white-space:nowrap;
}
.ptable td{border:1px solid rgba(255,255,255,0.05);padding:0}
.ncol{
  padding:0 10px;min-width:130px;max-width:160px;
  position:sticky;left:0;z-index:3;
  border-right:1px solid rgba(255,255,255,0.08)!important;
}
.ncol-inner{display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;height:58px;gap:2px}
.emp-tri{font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:700;letter-spacing:1px}
.emp-name{font-size:10px;font-weight:600;line-height:1.25;color:rgba(255,255,255,0.9)}

/* Half-day cells */
.hw{display:flex;flex-direction:column;height:58px}
.hd{
  flex:1;display:flex;align-items:center;justify-content:center;
  font-size:9px;font-weight:700;cursor:pointer;
  border:none;background:transparent;color:var(--t4);
  font-family:'Outfit',sans-serif;letter-spacing:0.3px;
  transition:filter .12s,opacity .12s;padding:1px 3px;
  text-align:center;line-height:1.2;user-select:none;
}
.hd:first-child{border-bottom:1px solid rgba(255,255,255,0.05)}
.hd:hover{filter:brightness(1.3) saturate(1.2)}

/* Types */
.ht{background:rgba(41,121,255,0.18);color:#82b1ff}
.hco{background:rgba(0,229,176,0.16);color:var(--mint)}
.hm{background:rgba(255,77,109,0.16);color:var(--rose)}
.hfo{background:rgba(255,208,96,0.18);color:var(--gold)}
.hab{background:rgba(255,154,60,0.16);color:var(--orange)}
.hdp{background:rgba(192,132,252,0.16);color:var(--purple)}
/* Weekend & Férié — TOUJOURS cliquables */
.hwe{background:rgba(255,255,255,0.03);color:rgba(255,255,255,0.22);cursor:pointer}
.hwe:hover{background:rgba(255,255,255,0.08)!important;color:rgba(255,255,255,0.6)!important;filter:none!important}
.hfe{background:rgba(255,208,96,0.09);color:rgba(255,208,96,0.6);cursor:pointer}
.hfe:hover{background:rgba(255,208,96,0.18)!important;color:rgba(255,208,96,1)!important;filter:none!important}

/* Day header styles */
.day-we{opacity:.35!important}
.day-hol{opacity:.7!important}

/* ═══ MODAL ═══ */
.mbg{
  display:none;position:fixed;inset:0;
  background:rgba(0,0,0,0.6);z-index:500;
  align-items:center;justify-content:center;padding:16px;
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
}
.mbg.on{display:flex}
.modal{
  background:rgba(14,22,40,0.95);
  border:1px solid var(--glass-border-bright);
  border-radius:var(--r24);padding:26px;
  width:100%;max-width:520px;max-height:88vh;
  overflow-y:auto;display:flex;flex-direction:column;
  box-shadow:var(--sh-lg),0 0 60px rgba(0,210,255,0.06);
  animation:mIn .25s cubic-bezier(.34,1.56,.64,1);
}
@keyframes mIn{from{transform:scale(.9) translateY(12px);opacity:0}to{transform:scale(1) translateY(0);opacity:1}}
.modal-title{font-size:20px;font-weight:800;color:var(--t1);margin-bottom:20px;letter-spacing:-0.5px;flex-shrink:0}
.mfooter{
  display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;
  margin-top:16px;padding-top:14px;flex-shrink:0;
  border-top:1px solid var(--glass-border);
  position:sticky;bottom:-26px;
  background:rgba(14,22,40,0.97);
  backdrop-filter:blur(10px);
  padding-bottom:4px;
}

/* ── Gantt Chart ── */
.gantt-wrap{min-width:700px}
.gantt-header{display:flex;border-bottom:1px solid var(--glass-border);margin-bottom:6px}
.gantt-label-col{width:200px;flex-shrink:0;font-size:10px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.5px;padding:0 10px 6px}
.gantt-months{flex:1;display:flex}
.gantt-month-cell{flex:1;text-align:center;font-size:10px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.5px;padding-bottom:6px;border-left:1px solid rgba(255,255,255,0.04)}
.gantt-row{display:flex;align-items:center;min-height:42px;border-bottom:1px solid rgba(255,255,255,0.03);transition:background .12s}
.gantt-row:hover{background:var(--glass-1)}
.gantt-row-label{width:200px;flex-shrink:0;padding:6px 10px}
.gantt-row-name{font-size:12px;font-weight:700;color:var(--t1);line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gantt-row-meta{font-size:10px;color:var(--t3);margin-top:1px}
.gantt-timeline{flex:1;position:relative;height:42px}
.gantt-bar{
  position:absolute;top:8px;height:26px;border-radius:6px;
  display:flex;align-items:center;padding:0 8px;
  font-size:9px;font-weight:700;font-family:'JetBrains Mono',monospace;
  letter-spacing:.3px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;
  transition:filter .15s;cursor:default;
  box-shadow:0 2px 8px rgba(0,0,0,0.3);
}
.gantt-bar:hover{filter:brightness(1.15)}
.gantt-today-line{position:absolute;top:0;bottom:0;width:1.5px;background:var(--rose);opacity:.7;z-index:2}
.gantt-today-line::before{content:'▼';position:absolute;top:-1px;left:50%;transform:translateX(-50%);font-size:8px;color:var(--rose)}
.gantt-grid-line{position:absolute;top:0;bottom:0;width:1px;background:rgba(255,255,255,0.03)}
.gantt-empty{text-align:center;padding:30px;color:var(--t4);font-size:13px}


.auth-chip{
  padding:7px 13px;border-radius:99px;cursor:pointer;
  font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:700;
  letter-spacing:0.5px;border:1.5px solid var(--glass-border);
  background:var(--glass-1);color:var(--t3);
  transition:all .15s;user-select:none;
}
.auth-chip:hover{border-color:var(--cyan);color:var(--t1);background:rgba(0,210,255,0.06)}
.auth-chip.on{
  background:rgba(0,210,255,0.15);border-color:var(--cyan);
  color:var(--cyan);box-shadow:0 0 10px rgba(0,210,255,0.15);
}

/* ── Ratio widget ── */
.ratio-card{
  background:var(--glass-1);border:1px solid var(--glass-border);
  border-radius:var(--r20);padding:18px 20px;margin-bottom:14px;
  box-shadow:var(--sh-sm);
}
.ratio-title{font-size:13px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--t2);margin-bottom:14px;display:flex;align-items:center;gap:8px}
.ratio-bar-wrap{position:relative;height:28px;border-radius:99px;overflow:hidden;background:rgba(255,255,255,0.05);margin-bottom:10px}
.ratio-bar-tech{position:absolute;left:0;top:0;height:100%;background:linear-gradient(90deg,#2979ff,#00d2ff);transition:width .6s cubic-bezier(.34,1.56,.64,1)}
.ratio-bar-int{position:absolute;top:0;height:100%;background:linear-gradient(90deg,#c084fc,#e040fb);transition:all .6s cubic-bezier(.34,1.56,.64,1)}
.ratio-bar-label{position:absolute;top:50%;transform:translateY(-50%);font-size:10px;font-weight:700;font-family:'JetBrains Mono',monospace;pointer-events:none;white-space:nowrap}
.ratio-legend{display:flex;gap:16px;flex-wrap:wrap}
.ratio-leg{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--t2)}
.ratio-leg-dot{width:10px;height:10px;border-radius:3px;flex-shrink:0}

/* ── Gantt Chart ── */
.gantt-wrap{overflow-x:auto;padding:4px 0}
.gantt-container{min-width:800px;position:relative}
.gantt-label-col{width:220px;flex-shrink:0}
.gantt-header{display:flex;margin-bottom:0}
.gantt-months{flex:1;display:flex;background:rgba(255,255,255,0.02);border-bottom:1px solid rgba(255,255,255,0.07)}
.gantt-month{flex:1;text-align:center;font-size:10px;font-weight:700;color:var(--t3);padding:6px 2px;letter-spacing:.5px;text-transform:uppercase;border-right:1px solid rgba(255,255,255,0.05);min-width:36px}
.gantt-month.cur{color:var(--cyan);background:rgba(0,210,255,0.05)}
.gantt-rows{position:relative}
.gantt-row{display:flex;align-items:center;border-bottom:1px solid rgba(255,255,255,0.04);min-height:48px}
.gantt-row:hover{background:rgba(255,255,255,0.02)}
.gantt-row-label{
  width:220px;flex-shrink:0;padding:8px 14px;
  border-right:1px solid rgba(255,255,255,0.06);
  background:rgba(10,16,32,0.75);
  position:sticky;left:0;z-index:2;
}
.glabel-name{font-size:11px;font-weight:700;color:var(--t1);line-height:1.35}
.glabel-client{font-size:10px;color:var(--t3);margin-top:1px}
.glabel-resp{font-size:9px;color:var(--t4);margin-top:2px}
.glabel-res{display:flex;flex-wrap:wrap;gap:3px;margin-top:3px}
.gres-tag{padding:1px 5px;border-radius:99px;font-size:8px;font-weight:700}
.gantt-timeline{flex:1;position:relative;height:48px}
.gantt-grid{position:absolute;inset:0;display:flex;pointer-events:none}
.gantt-gcol{flex:1;border-right:1px solid rgba(255,255,255,0.04);min-width:36px}
.gantt-gcol.cur-col{background:rgba(0,210,255,0.03)}
.gantt-bar{
  position:absolute;top:50%;transform:translateY(-50%);
  height:24px;border-radius:99px;min-width:4px;
  display:flex;align-items:center;justify-content:center;
  font-size:9px;font-weight:800;color:rgba(255,255,255,0.95);
  overflow:hidden;cursor:pointer;transition:filter .15s, box-shadow .15s;
  white-space:nowrap;padding:0 10px;
  box-shadow:0 2px 8px rgba(0,0,0,0.35);
  font-family:'JetBrains Mono',monospace;letter-spacing:.3px;
}
.gantt-bar::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,0.18) 0%,transparent 100%);border-radius:99px;}
.gantt-bar:hover{filter:brightness(1.25);box-shadow:0 0 16px rgba(255,255,255,0.15)}
.gantt-today{position:absolute;top:0;bottom:0;width:2px;background:var(--rose);opacity:.75;z-index:3;pointer-events:none}
.gantt-today::before{content:'Auj.';position:absolute;top:-17px;left:50%;transform:translateX(-50%);font-size:8px;font-weight:800;color:var(--rose);white-space:nowrap}
.gantt-empty{text-align:center;padding:32px;color:var(--t4);font-size:13px}
.gantt-leg-item{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--t3)}
.gantt-leg-dot{width:10px;height:10px;border-radius:3px;flex-shrink:0}
/* ── END Gantt ── */

.type-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:14px}
.tc{
  padding:12px 6px;border-radius:var(--r12);
  border:1.5px solid var(--glass-border);
  background:var(--glass-1);color:var(--t3);
  cursor:pointer;font-size:11px;font-weight:700;
  font-family:'Outfit',sans-serif;
  text-align:center;line-height:1.4;transition:all .15s;
}
.tc:hover{border-color:var(--cyan);background:rgba(0,210,255,0.06);color:var(--t1)}
.tc.sel{border-color:var(--cyan);background:rgba(0,210,255,0.12);color:var(--cyan);box-shadow:0 0 12px rgba(0,210,255,0.15)}
.tc.clr{border-style:dashed;color:var(--t4)}
.tc.we-sel{border-color:rgba(255,255,255,0.2);background:rgba(255,255,255,0.04);color:var(--t2)}
.tc.hol-sel{border-color:var(--gold);background:rgba(255,208,96,0.08);color:var(--gold)}

/* ═══ SIDE PANEL ═══ */
.sp{
  display:none;position:fixed;top:0;right:0;
  width:min(420px,100vw);height:100vh;
  background:rgba(10,16,32,0.97);
  border-left:1px solid var(--glass-border);
  z-index:400;overflow-y:auto;
  box-shadow:-8px 0 60px rgba(0,0,0,0.6);
  animation:spIn .28s cubic-bezier(.25,.46,.45,.94);
}
@keyframes spIn{from{transform:translateX(100%)}to{transform:translateX(0)}}
.sp.on{display:block}
.sp-top{
  display:flex;align-items:center;justify-content:space-between;
  padding:20px 22px 16px;
  border-bottom:1px solid var(--glass-border);
  position:sticky;top:0;z-index:10;
  background:rgba(10,16,32,0.9);
  backdrop-filter:blur(16px);
}
.sp-title{font-size:18px;font-weight:800;color:var(--t1);letter-spacing:-0.3px}
.sp-x{
  width:30px;height:30px;border-radius:50%;
  background:var(--glass-2);border:1px solid var(--glass-border);
  color:var(--t2);font-size:14px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;transition:all .15s;
}
.sp-x:hover{background:var(--rose);color:#fff;border-color:var(--rose)}
.sp-body{padding:22px}

/* ═══ STAFF CARDS ═══ */
.sgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(235px,1fr));gap:10px}
.sc{
  background:var(--glass-1);border:1px solid var(--glass-border);
  border-radius:var(--r20);padding:18px;cursor:pointer;
  transition:all .2s;position:relative;overflow:hidden;
}
.sc::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.sc.chef::before{background:linear-gradient(90deg,#ff5e00,#ff9a1a)}
.sc.responsable::before{background:linear-gradient(90deg,#e040fb,#ea80fc)}
.sc.technicien::before{background:linear-gradient(90deg,#a88c6a,#c9a87c)}
.sc.expert::before{background:linear-gradient(90deg,var(--blue),var(--cyan))}
.sc.alternant::before{background:linear-gradient(90deg,var(--mint),var(--lime))}
.sc.stagiaire::before{background:linear-gradient(90deg,var(--stag),#b2fcc9)}
.sc.interimaire::before{background:linear-gradient(90deg,var(--purple),#e8b4ff)}
.sc.prestataire::before{background:linear-gradient(90deg,#ffdd00,#fff176)}
.sc:hover{transform:translateY(-3px);box-shadow:var(--sh-md);border-color:var(--glass-border-bright)}
.sc:active{transform:scale(.98)}
.sc-avatar{
  width:44px;height:44px;border-radius:14px;
  display:flex;align-items:center;justify-content:center;
  font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:700;
  flex-shrink:0;
}

/* ═══ KANBAN ═══ */
.kanban{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
@media(max-width:1000px){.kanban{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.kanban{grid-template-columns:1fr}}
.kcol{
  background:rgba(255,255,255,0.025);
  border:1px solid var(--glass-border);
  border-radius:var(--r20);padding:16px;min-height:200px;
}
.kcol-head{
  font-size:12px;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;
  color:var(--t2);margin-bottom:14px;
  display:flex;align-items:center;justify-content:space-between;
}
.kcol-count{
  background:var(--glass-2);border-radius:99px;
  padding:2px 9px;font-size:11px;color:var(--t3);
}
.kcard{
  background:var(--glass-1);border:1px solid var(--glass-border);
  border-radius:var(--r16);padding:14px 15px;margin-bottom:9px;
  cursor:pointer;transition:all .18s;
  border-left:4px solid transparent;
}
.kcard:hover{box-shadow:var(--sh-md);transform:translateY(-1px);border-color:var(--glass-border-bright)}
.kcard-name{font-size:13px;font-weight:700;color:var(--t1);margin-bottom:6px;line-height:1.35}
.kcard-meta{font-size:11px;color:var(--t3);display:flex;flex-wrap:wrap;gap:5px;margin-top:5px}
.kcard-bar{height:3px;border-radius:2px;margin-top:10px}

/* ═══ TODO ═══ */
.todo{
  background:var(--glass-1);border:1px solid var(--glass-border);
  border-radius:var(--r16);padding:14px 16px;margin-bottom:9px;
  display:flex;align-items:flex-start;gap:12px;transition:all .15s;
}
.todo:hover{border-color:var(--glass-border-bright)}
.todo.done{opacity:.4}
.todo.done .todo-txt{text-decoration:line-through;color:var(--t3)}
.todo.late{border-left:3px solid var(--rose);padding-left:13px}
.todo-cb{
  width:22px;height:22px;border-radius:6px;
  border:2px solid var(--glass-border-bright);background:transparent;
  cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center;
  font-size:13px;transition:all .15s;margin-top:1px;
}
.todo-cb.done{background:var(--mint);border-color:var(--mint);color:#000}
.todo-txt{font-size:14px;flex:1;line-height:1.5;color:var(--t1)}
.todo-meta{font-size:11px;color:var(--t3);margin-top:4px;display:flex;gap:10px;flex-wrap:wrap}

/* ═══ FILTER TABS ═══ */
.ftabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.ftab{
  height:30px;padding:0 15px;border-radius:99px;
  background:var(--glass-1);border:1px solid var(--glass-border);
  color:var(--t3);font-size:12.5px;font-weight:600;cursor:pointer;
  transition:all .15s;font-family:'Outfit',sans-serif;
}
.ftab:hover{border-color:var(--glass-border-bright);color:var(--t2)}
.ftab.on{background:rgba(0,210,255,0.12);border-color:rgba(0,210,255,0.3);color:var(--cyan)}

/* ═══ LEGEND ═══ */
.legend{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.leg{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--t3);font-weight:500}
.leg-dot{width:11px;height:11px;border-radius:4px;flex-shrink:0}

/* ═══ NAV PILLS ═══ */
.navrow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.period-lbl{
  font-size:17px;font-weight:800;color:var(--t1);
  min-width:220px;text-align:center;letter-spacing:-0.4px;
}
.exprow{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px}

/* ═══ HOLIDAY TAGS ═══ */
.htags{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.htag{
  display:flex;align-items:center;gap:7px;
  background:rgba(255,208,96,0.1);border:1px solid rgba(255,208,96,0.2);
  border-radius:99px;padding:5px 12px;
  font-size:12px;font-weight:600;color:var(--gold);
}
.htag-del{
  background:none;border:none;cursor:pointer;
  color:var(--gold);opacity:.5;font-size:14px;
  display:flex;align-items:center;transition:opacity .15s;
}
.htag-del:hover{opacity:1}

/* ═══ MATRIX ═══ */
.mwrap{overflow-x:auto}
.mtable{border-collapse:collapse;font-size:11px;width:max-content;min-width:100%}
.mtable td,.mtable th{min-width:44px}
.mtable th,.mtable td{border:1px solid rgba(255,255,255,0.05)}
.mtable thead th{
  background:rgba(255,255,255,0.04);padding:8px 6px;
  font-size:9.5px;font-weight:700;text-transform:uppercase;
  letter-spacing:0.4px;color:var(--t3);
  white-space:nowrap;text-align:center;
}
.mtable thead th.rot{
  writing-mode:horizontal-tb;
  -webkit-writing-mode:horizontal-tb;
  transform:none;
  white-space:normal;
  word-break:break-word;
  height:auto;min-width:48px;max-width:60px;width:60px;
  vertical-align:bottom;text-align:center;
  padding:5px 3px 4px;font-size:8px;font-weight:700;
  color:var(--t2);letter-spacing:.1px;line-height:1.3;
}
.mtable tbody td{padding:8px 10px}
.mtable tbody tr:hover td{background:var(--glass-1)}

/* ═══ COLOR SWATCHES ═══ */
.swatches{display:flex;flex-wrap:wrap;gap:7px;margin-top:8px}
.sw{
  width:28px;height:28px;border-radius:50%;cursor:pointer;
  border:2px solid transparent;transition:all .15s;
}
.sw:hover{transform:scale(1.2)}
.sw.on{border-color:#fff;box-shadow:0 0 0 2px rgba(255,255,255,0.15),0 0 12px currentColor}

/* ═══ DRIVE BANNER ═══ */
.drive-banner{
  display:flex;align-items:flex-start;gap:14px;
  background:var(--glass-1);border:1px solid var(--glass-border);
  border-radius:var(--r16);padding:16px 18px;margin-bottom:16px;
}
.drive-ico{
  width:46px;height:46px;border-radius:14px;flex-shrink:0;
  background:rgba(41,121,255,0.1);border:1px solid rgba(41,121,255,0.2);
  display:flex;align-items:center;justify-content:center;font-size:22px;
}

/* ═══ EMPTY ═══ */
.empty{text-align:center;padding:44px 20px;color:var(--t3)}
.empty-ico{font-size:42px;margin-bottom:12px}
.empty p{font-size:14px}

/* ═══ TOAST ═══ */
.toast{
  position:fixed;bottom:28px;left:50%;
  transform:translateX(-50%) translateY(90px);
  background:rgba(14,22,40,0.95);border:1px solid var(--glass-border-bright);
  color:var(--t1);border-radius:99px;padding:11px 20px;
  font-size:13px;font-weight:600;z-index:9999;
  box-shadow:var(--sh-lg),var(--sh-glow-cyan);
  transition:transform .35s cubic-bezier(.34,1.56,.64,1);
  display:flex;align-items:center;gap:8px;backdrop-filter:blur(16px);
}
.toast.show{transform:translateX(-50%) translateY(0)}

/* ═══ INFO ROW ═══ */
.irow{
  display:flex;align-items:center;justify-content:space-between;
  padding:11px 0;border-bottom:1px solid rgba(255,255,255,0.05);gap:8px;
}
.irow:last-child{border-bottom:none}
.irow-k{font-size:13px;color:var(--t2)}
.irow-v{font-size:13px;color:var(--t3);font-family:'JetBrains Mono',monospace;font-size:12px}

/* ═══ SECTION DIV ═══ */
.sdiv{
  font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;
  color:var(--t4);padding:12px 0 8px;
  border-bottom:1px solid rgba(255,255,255,0.04);margin-bottom:10px;
}

/* ═══ PRINT ═══ */
@media print{
  .header,.tabbar,.exprow,.navrow,.legend,.sh .btn-row,
  .ftabs,.sp,.toast{display:none!important}
  html,body{height:auto;overflow:visible;background:#fff}
  .body{overflow:visible}
  .page{display:none!important}
  .page.on{display:block!important;max-width:none;padding:0}
  .gc{background:#fff;border-color:#e0e0e0;box-shadow:none}
  .ptable th,.ptable td{border-color:#ddd!important}
  .hd{font-size:8px!important}
  .ht{background:#dbeafe!important;-webkit-print-color-adjust:exact}
  .hco{background:#dcfce7!important;-webkit-print-color-adjust:exact}
  .hm{background:#fee2e2!important;-webkit-print-color-adjust:exact}
  .hfo{background:#fef9c3!important;-webkit-print-color-adjust:exact}
  .hab{background:#ffedd5!important;-webkit-print-color-adjust:exact}
  .hdp{background:#f3e8ff!important;-webkit-print-color-adjust:exact}
  .hwe,.hfe{background:#f5f5f5!important;-webkit-print-color-adjust:exact}
}

/* ═══ MOBILE ═══ */
@media(max-width:640px){
  .header-inner{height:54px}
  .logo-sub,.logo-name{font-size:15px}
  .hbtn span{display:none}
  .stats{grid-template-columns:repeat(2,1fr)}
  .fgrid{grid-template-columns:1fr}
  .type-grid{grid-template-columns:repeat(2,1fr)}
  .page{padding:14px 12px}
}
</style>
</head>
<body>

<!-- ═══════════ HEADER ═══════════ -->
<header class="header">
<div class="header-inner">
  <a class="logo" onclick="goTab('dashboard');return false" href="#">
    <div class="logo-icon" style="background:none;box-shadow:none">
      <img src="data:image/png;base64," width="40" height="40"
        style="object-fit:contain;filter:invert(1) sepia(1) saturate(3) hue-rotate(185deg) brightness(2);display:block"/>
    </div>
    <div class="logo-words">
      <div class="logo-name" style="font-size:13px;letter-spacing:0.3px">
        <span style="background:linear-gradient(90deg,#e0f0ff,#a0f8e8);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:900">MARDAM</span>
        <span style="color:rgba(255,255,255,0.9);font-weight:700"> AeroDesk</span>
        <span style="color:#4a9aff;font-size:9px;font-weight:900;vertical-align:middle;margin-left:2px">PRO</span>
      </div>
      <div class="logo-sub" style="color:#4a6a8a;letter-spacing:1px;font-size:8px">by Campoy</div>
    </div>
  </a>

  <div class="hspacer"></div>
  <div class="header-right">
    <div class="alert-pill" id="alertPill">⚠ <span id="alertN">0</span></div>
    <div class="drive-pill" id="drivePill" onclick="openM('m-drive')">
      <div class="drive-dot" id="driveDot"></div>
      <span id="driveLbl">Google Drive</span>
    </div>
    <button class="hbtn hbtn-ghost" onclick="exportAll()">💾 <span>Backup</span></button>
    <button class="hbtn hbtn-ghost" onclick="document.getElementById('jsonIn').click()">📥 <span>Restaurer</span></button>
  </div>
</div>
</header>

<!-- ═══════════ TABS ═══════════ -->
<nav class="tabbar">
<div class="tab-scroll">
  <button class="tab active" id="tb-dashboard" onclick="goTab('dashboard')">🏠 Tableau de bord</button>
  <button class="tab" id="tb-formations" onclick="goTab('formations')">📋 Formations<span class="tab-notif" id="nt-form"></span></button>
  <button class="tab" id="tb-master"    onclick="goTab('master')">📅 Master Planning</button>
  <button class="tab" id="tb-weekly"    onclick="goTab('weekly')">🗓 Planning Hebdo</button>
  <button class="tab" id="tb-chantiers" onclick="goTab('chantiers')">🔧 Chantiers</button>
  <button class="tab" id="tb-personnel" onclick="goTab('personnel')">👥 Personnel</button>
  <button class="tab" id="tb-todo"      onclick="goTab('todo')">✅ To-Do<span class="tab-notif" id="nt-todo"></span></button>
  <button class="tab" id="tb-autorisations" onclick="goTab('autorisations')">🛡 Autorisations<span class="tab-notif" id="nt-auto"></span></button>
  <button class="tab" id="tb-programme" onclick="goTab('programme')">📊 Programme Activité</button>
  <button class="tab" id="tb-ai" onclick="goTab('ai')" style="background:linear-gradient(135deg,rgba(41,121,255,0.15),rgba(0,210,255,0.15));border:1px solid rgba(0,210,255,0.25)">✦ Assistant IA</button>
</div>
</nav>

<!-- ═══════════ PAGES ═══════════ -->
<div class="body">

<!-- DASHBOARD -->
<div class="page on" id="pg-dashboard">
  <div class="sh">
    <div class="sh-title">Tableau de <em>Bord</em></div>
    <span id="todayLbl" style="font-size:13px;color:var(--t3);font-weight:500"></span>
  </div>
  <div class="stats" id="statsGrid"></div>
  <div id="ratioWidget"></div>
  <div id="avancementWidget"></div>
  <div class="gc" style="margin-bottom:14px">
    <div class="gc-head">
      <div class="gc-title">⚠️ Alertes actives</div>
      <button class="btn btn-ghost btn-sm" onclick="goTab('formations')">Voir formations →</button>
    </div>
    <div id="alertsBox"><div class="empty"><div class="empty-ico">✅</div><p>Aucune alerte — tout est à jour !</p></div></div>
  </div>
  <div class="gc">
    <div class="gc-head"><div class="gc-title">📊 Matrice formations</div></div>
    <div id="matrixBox"></div>
  </div>
</div>

<!-- FORMATIONS -->
<div class="page" id="pg-formations">
  <div class="sh">
    <div class="sh-title">Suivi des <em>Formations</em></div>
    <div class="btn-row">
      <button class="btn btn-cyan btn-sm" onclick="openFormModal()">+ Ajouter</button>
      <button class="btn btn-ghost btn-sm" onclick="document.getElementById('xlsIn').click()">📥 Import Excel</button>
      <button class="btn btn-mint btn-sm" onclick="exportFormXls()">📤 Export Excel</button>
    </div>
  </div>
  <div class="gc" style="margin-bottom:12px">
    <div class="gc-body">
      <div class="fgrid" style="margin-bottom:0">
        <div class="field"><label>Employé</label><select id="flt-emp" onchange="renderForms()"><option value="">Tous</option></select></div>
        <div class="field"><label>Type</label>
          <select id="flt-type" onchange="renderForms()">
            <option value="">Tous</option>
            <option>CACES NACELLE</option><option>CACES CHARIOT</option><option>CACES TRACMA</option><option>CACES TELESCO</option><option>CACES GERBEUR</option><option>EWIS</option><option>CDCCL</option><option>SAFETY TRAINING</option>
            <option>English Test</option><option>MOE / PART 145</option><option>Welcome HSE</option>
            <option>Travail en hauteur</option>
            <option>Risque chimiques</option><option>Compétences</option><option>Licence Part 66</option><option>Pushback</option>
          </select>
        </div>
        <div class="field"><label>Statut</label>
          <select id="flt-status" onchange="renderForms()">
            <option value="">Tous</option>
            <option value="valid">✅ Valide</option>
            <option value="warning">⚠️ Bientôt (&lt;30j)</option>
            <option value="expired">❌ Expiré</option>
            <option value="na">∞ Sans limite</option>
          </select>
        </div>
      </div>
    </div>
  </div>
  <div class="gc" style="overflow:hidden;padding:0">
    <div class="tscroll">
      <table><thead><tr>
        <th>Employé</th><th>TRI</th><th>Catégorie</th><th>Formation</th>
        <th>Obtention</th><th>Expiration</th><th>Statut</th><th>Notes</th><th></th>
      </tr></thead><tbody id="formTbody"></tbody></table>
    </div>
  </div>
</div>

<!-- MASTER PLANNING -->
<div class="page" id="pg-master">
  <div class="sh">
    <div class="sh-title">Master <em>Planning</em></div>
    <div class="btn-row">
      <select id="mp-emp" onchange="renderMaster()" style="width:150px;height:34px;border-radius:99px;padding:0 14px"><option value="">Tous les employés</option></select>
      <select id="mp-year" onchange="renderMaster()" style="width:90px;height:34px;border-radius:99px;padding:0 12px" id="mp-year"></select>
      <button class="btn btn-gold btn-sm" onclick="openM('m-hol')">🎉 Jours fériés</button>
    </div>
  </div>
  <div class="legend" id="legMaster"></div>
  <div class="exprow">
    <button class="btn btn-mint btn-sm" onclick="exportMasterXls()">📊 Export Excel</button>
    <button class="btn btn-cyan btn-sm" onclick="exportMasterPDF()">📄 Export PDF</button>
  </div>
  <div class="gc" style="padding:14px">
    <div class="navrow">
      <button class="btn btn-ghost btn-sm" onclick="chMonth(-1)">← Préc.</button>
      <div class="period-lbl" id="masterLbl"></div>
      <button class="btn btn-ghost btn-sm" onclick="chMonth(1)">Suiv. →</button>
      <button class="btn btn-ghost btn-sm" onclick="goToday()">Aujourd'hui</button>
    </div>
    <div class="pscroll" id="masterGrid"></div>
  </div>
</div>

<!-- WEEKLY PLANNING -->
<div class="page" id="pg-weekly">
  <div class="sh">
    <div class="sh-title">Planning <em>Hebdomadaire</em></div>
  </div>
  <div class="navrow">
    <button class="btn btn-ghost btn-sm" onclick="chWeek(-1)">← Préc.</button>
    <div class="period-lbl" id="weekLbl"></div>
    <button class="btn btn-ghost btn-sm" onclick="chWeek(1)">Suiv. →</button>
    <button class="btn btn-ghost btn-sm" onclick="thisWeek()">Cette semaine</button>
  </div>
  <div class="exprow">
    <button class="btn btn-mint btn-sm" onclick="exportWeekXls()">📊 Export Excel</button>
    <button class="btn btn-cyan btn-sm" onclick="window.print()">📄 PDF / Imprimer</button>
    <button class="btn btn-rose btn-sm" onclick="openDayExtract()">📧 Extrait du jour</button>
    <button class="btn btn-gold btn-sm" onclick="openM('m-hol')">🎉 Jours fériés</button>
  </div>
  <div class="legend" id="legWeekly"></div>
  <div class="gc" style="padding:12px">
    <div class="pscroll" id="weeklyGrid"></div>
  </div>
</div>

<!-- CHANTIERS -->
<div class="page" id="pg-chantiers">
  <div class="sh">
    <div class="sh-title">Suivi des <em>Chantiers</em></div>
    <button class="btn btn-cyan btn-sm" onclick="openChantierNew()">+ Nouveau chantier</button>
  </div>

  <!-- Alerte double affectation -->
  <div id="chantier-conflicts" style="margin-bottom:12px"></div>

  <!-- Gantt responsables/chefs -->
  <div class="gc" style="margin-bottom:18px">
    <div class="gc-head">
      <div class="gc-title">📊 Planning Responsables & Chefs d'équipe</div>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <select id="gantt-resp-year" onchange="renderChantiers()" style="height:30px;border-radius:99px;padding:0 12px;font-size:12px;background:var(--glass-1);border:1px solid var(--glass-border);color:var(--t1)"></select>
        <div style="display:flex;gap:8px;flex-wrap:wrap;font-size:10px;color:var(--t3)">
          <span style="display:flex;align-items:center;gap:4px"><span style="width:10px;height:10px;border-radius:2px;background:#6effc4;display:inline-block"></span>Congé</span>
          <span style="display:flex;align-items:center;gap:4px"><span style="width:10px;height:10px;border-radius:2px;background:#ffe066;display:inline-block"></span>Formation</span>
          <span style="display:flex;align-items:center;gap:4px"><span style="width:10px;height:10px;border-radius:2px;background:#d9a8ff;display:inline-block"></span>Déplacement</span>
          <span style="display:flex;align-items:center;gap:4px"><span style="width:10px;height:10px;border-radius:2px;background:#ff9999;display:inline-block"></span>Maladie</span>
          <span style="display:flex;align-items:center;gap:4px"><span style="width:10px;height:10px;border-radius:2px;background:#ffb366;display:inline-block"></span>Absence</span>
        </div>
      </div>
    </div>
    <div id="gantt-resp" style="overflow-x:auto"></div>
  </div>

  <div class="kanban" id="kanban"></div>
</div>

<!-- PERSONNEL -->
<div class="page" id="pg-personnel">
  <div class="sh">
    <div class="sh-title">Gestion du <em>Personnel</em></div>
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
      <div style="position:relative">
        <span style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--t4);font-size:13px;pointer-events:none">🔍</span>
        <input type="search" id="staff-search" placeholder="Nom, prénom ou trigramme…"
          oninput="renderPersonnel()"
          style="padding:7px 12px 7px 30px;border-radius:99px;border:1px solid var(--glass-border);background:var(--glass-1);color:var(--t1);font-size:12px;width:200px;outline:none"
          onfocus="this.style.borderColor='var(--cyan)'" onblur="this.style.borderColor='var(--glass-border)'">
      </div>
      <button class="btn btn-cyan btn-sm" onclick="openPersNew()">+ Ajouter</button>
    </div>
  </div>
  <div class="ftabs" id="persTabs">
    <button class="ftab on" onclick="filterStaff('all',this)">Tous</button>
    <button class="ftab" onclick="filterStaff('responsable',this)">Resp. Projet</button>
    <button class="ftab" onclick="filterStaff('chef',this)">Chefs d'équipe</button>
    <button class="ftab" onclick="filterStaff('technicien',this)">Techniciens</button>
    <button class="ftab" onclick="filterStaff('expert',this)">Experts</button>
    <button class="ftab" onclick="filterStaff('alternant',this)">Alternants</button>
    <button class="ftab" onclick="filterStaff('stagiaire',this)">Stagiaires</button>
    <button class="ftab" onclick="filterStaff('interimaire',this)">Intérimaires</button>
    <button class="ftab" onclick="filterStaff('prestataire',this)">Prestataires</button>
  </div>
  <div class="sgrid" id="staffGrid"></div>
</div>

<!-- TODO -->
<div class="page" id="pg-todo">
  <div class="sh">
    <div class="sh-title">To-Do <em>List</em></div>
    <button class="btn btn-cyan btn-sm" onclick="openTodoNew()">+ Nouvelle tâche</button>
  </div>
  <div class="ftabs">
    <button class="ftab on" onclick="filterTodo('all',this)">Toutes</button>
    <button class="ftab" onclick="filterTodo('pending',this)">En attente</button>
    <button class="ftab" onclick="filterTodo('late',this)">⚠ En retard</button>
    <button class="ftab" onclick="filterTodo('done',this)">✅ Terminées</button>
  </div>
  <div id="todoList"></div>
</div>

<!-- AUTORISATIONS -->
<div class="page" id="pg-autorisations">
  <div class="sh">
    <div class="sh-title"><em>Autorisations</em></div>
    <div class="btn-row">
      <button class="btn btn-cyan btn-sm" onclick="openAutoModal()">+ Ajouter</button>
      <button class="btn btn-ghost btn-sm" onclick="exportAutoXls()">📤 Export Excel</button>
    </div>
  </div>

  <!-- Filters -->
  <div class="gc" style="margin-bottom:12px">
    <div class="gc-body">
      <div class="fgrid" style="margin-bottom:0">
        <div class="field"><label>Employé</label><select id="auto-flt-emp" onchange="renderAutorisations()"><option value="">Tous</option></select></div>
        <div class="field"><label>Autorisation</label>
          <select id="auto-flt-type" onchange="renderAutorisations()">
            <option value="">Toutes</option>
            <option>AMEC</option><option>ASTO</option><option>IMEC</option><option>ISTO</option>
            <option>AELE</option><option>IELE</option><option>ASTR</option><option>ISTR</option>
            <option>ACOM</option><option>ICOM</option><option>AENB</option><option>IENB</option>
            <option>ABAT</option><option>IBAT</option>
          </select>
        </div>
        <div class="field"><label>Statut</label>
          <select id="auto-flt-status" onchange="renderAutorisations()">
            <option value="">Tous</option>
            <option value="valid">✅ Valide</option>
            <option value="warning">⚠️ Expire bientôt</option>
            <option value="expired">❌ Expiré</option>
            <option value="na">∞ Sans limite</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Table -->
  <div class="gc" style="overflow:hidden;padding:0;margin-bottom:14px">
    <div class="tscroll">
      <table><thead><tr>
        <th>Employé</th><th>TRI</th><th>Catégorie</th><th>Autorisation</th>
        <th>Obtention</th><th>Expiration</th><th>Statut</th><th>Notes</th><th></th>
      </tr></thead><tbody id="autoTbody"></tbody></table>
    </div>
  </div>

  <!-- Matrice -->
  <div class="gc">
    <div class="gc-head"><div class="gc-title">🛡 Matrice des autorisations</div></div>
    <div id="autoMatrixBox"></div>
  </div>

</div><!-- /pg-autorisations -->

<!-- PROGRAMME ACTIVITÉ -->
<!-- PROGRAMME ACTIVITÉ -->
<div class="page" id="pg-programme">
  <div class="sh">
    <div class="sh-title">Programme <em>Activité</em></div>
    <div class="btn-row">
      <select id="gantt-year" onchange="renderProgramme()" style="height:34px;border-radius:99px;padding:0 14px;width:100px"></select>
      <button class="btn btn-ghost btn-sm" onclick="exportGanttPDF()">📄 Export PDF</button>
    </div>
  </div>

  <!-- CHARGE / CAPACITÉ -->
  <div class="gc" style="margin-bottom:18px">
    <div class="gc-head">
      <div class="gc-title">⚖️ Charge / Capacité Techniciens</div>
      <div style="display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:var(--t3)">
        <span>🟢 Dispo &nbsp;🔴 Manque &nbsp;⚪ Aucun chantier</span>
      </div>
    </div>
    <div id="chargeCapaTable" style="overflow-x:auto"></div>
  </div>

  <!-- GANTT -->
  <div class="gc" style="margin-bottom:18px">
    <div class="gc-head">
      <div class="gc-title">📊 Programme des chantiers</div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
        <div class="gantt-leg-item"><div class="gantt-leg-dot" style="background:#34c759"></div>Validés (En cours / À venir / Terminé)</div>
        <div class="gantt-leg-item"><div class="gantt-leg-dot" style="background:#8e8e93"></div>Prévisionnels</div>
      </div>
    </div>
    <div id="gantt1" class="gantt-wrap"></div>
  </div>
</div>

<!-- ✦ ASSISTANT IA -->
<div class="page" id="pg-ai">
  <div class="sh">
    <div class="sh-title">✦ <em>Assistant IA</em></div>
    <div style="font-size:11px;color:var(--t4)">Posez vos questions sur votre activité</div>
  </div>

  <!-- Suggestions rapides -->
  <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px" id="ai-suggestions">
    <button onclick="aiAsk(this.textContent)" style="background:rgba(41,121,255,0.1);border:1px solid rgba(41,121,255,0.25);color:#60b4ff;border-radius:99px;padding:7px 14px;font-size:12px;cursor:pointer;font-family:'Outfit',sans-serif">Ai-je la capacité pour un chantier en novembre ?</button>
    <button onclick="aiAsk(this.textContent)" style="background:rgba(41,121,255,0.1);border:1px solid rgba(41,121,255,0.25);color:#60b4ff;border-radius:99px;padding:7px 14px;font-size:12px;cursor:pointer;font-family:'Outfit',sans-serif">Quelles formations expirent bientôt ?</button>
    <button onclick="aiAsk(this.textContent)" style="background:rgba(41,121,255,0.1);border:1px solid rgba(41,121,255,0.25);color:#60b4ff;border-radius:99px;padding:7px 14px;font-size:12px;cursor:pointer;font-family:'Outfit',sans-serif">Quel est l'état d'avancement de mes chantiers ?</button>
    <button onclick="aiAsk(this.textContent)" style="background:rgba(41,121,255,0.1);border:1px solid rgba(41,121,255,0.25);color:#60b4ff;border-radius:99px;padding:7px 14px;font-size:12px;cursor:pointer;font-family:'Outfit',sans-serif">Combien de techniciens sont disponibles cette semaine ?</button>
    <button onclick="aiAsk(this.textContent)" style="background:rgba(41,121,255,0.1);border:1px solid rgba(41,121,255,0.25);color:#60b4ff;border-radius:99px;padding:7px 14px;font-size:12px;cursor:pointer;font-family:'Outfit',sans-serif">Résume mon équipe actuelle</button>
  </div>

  <!-- Zone de conversation -->
  <div class="gc" style="padding:0;display:flex;flex-direction:column;height:calc(100vh - 280px);min-height:300px">
    <div id="ai-messages" style="flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px">
      <div style="text-align:center;color:var(--t4);font-size:12px;padding:20px">
        <div style="font-size:32px;margin-bottom:8px">✦</div>
        <div>Bonjour Damien ! Je connais toutes vos données en temps réel.<br>Posez-moi n'importe quelle question sur votre équipe, vos chantiers ou votre planning.</div>
      </div>
    </div>

    <!-- Barre de saisie -->
    <div style="border-top:1px solid rgba(255,255,255,0.08);padding:12px 16px;display:flex;gap:10px;align-items:flex-end">
      <textarea id="ai-input" placeholder="Posez votre question ou appuyez sur 🎤..." rows="1"
        onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();aiSend();}"
        oninput="this.style.height='auto';this.style.height=Math.min(this.scrollHeight,120)+'px'"
        style="flex:1;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;color:var(--t1);font-size:14px;font-family:'Outfit',sans-serif;padding:10px 14px;resize:none;outline:none;line-height:1.5;max-height:120px"></textarea>
      <button onclick="aiVoice()" id="ai-voice-btn" title="Commande vocale"
        style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:12px;color:#c0d0e8;font-size:18px;cursor:pointer;padding:10px 13px;flex-shrink:0;transition:all .2s">🎤</button>
      <button onclick="aiSend()" id="ai-send-btn"
        style="background:linear-gradient(135deg,#2979ff,#00d2ff);border:none;border-radius:12px;color:#000;font-size:18px;font-weight:900;cursor:pointer;padding:10px 16px;flex-shrink:0;transition:opacity .2s">→</button>
    </div>
  </div>
</div>

</div><!-- /body -->

<!-- ═══════════ MODALS ═══════════ -->

<!-- Cell edit -->
<div class="mbg" id="m-cell">
<div class="modal" style="max-width:440px">
  <div class="modal-title" id="cellTitle">Modifier</div>
  <div class="type-grid" id="typeGrid">
    <button class="tc" data-t="travail"    onclick="pickType(this)">✈️<br>Travail</button>
    <button class="tc" data-t="conge"      onclick="pickType(this)">🏖️<br>Congé</button>
    <button class="tc" data-t="maladie"    onclick="pickType(this)">🏥<br>Maladie</button>
    <button class="tc" data-t="formation"  onclick="pickType(this)">📚<br>Formation</button>
    <button class="tc" data-t="absence"    onclick="pickType(this)">❌<br>Absence</button>
    <button class="tc" data-t="deplacement"onclick="pickType(this)">🚗<br>Déplacement</button>
    <button class="tc we-sel" data-t="we"  onclick="pickType(this)">📅<br>Week-end</button>
    <button class="tc hol-sel" data-t="ferie" onclick="pickType(this)">🎉<br>Jour férié</button>
    <button class="tc clr" data-t=""       onclick="pickType(this)">✕<br>Effacer</button>
  </div>
  <div id="wrapChantier" style="display:none;margin-bottom:11px">
    <div class="field">
      <label style="color:var(--cyan)">⚠ Chantier associé <span style="color:var(--rose);font-weight:700">*</span> <span style="font-size:9px;color:var(--t4);font-weight:400">(requis pour le suivi Man/Hours)</span></label>
      <select id="cellChantier" style="border-color:rgba(0,210,255,0.3);background:rgba(0,210,255,0.05)"><option value="">— Sélectionner le chantier —</option></select>
    </div>
  </div>
  <div id="wrapNote" style="display:none;margin-bottom:11px">
    <div class="field"><label>Note / Détail</label>
      <input type="text" id="cellNote" placeholder="CACES NACELLE, déplacement Lyon...">
    </div>
  </div>
  <div style="margin-bottom:14px">
    <div class="field"><label>Appliquer à</label>
      <select id="cellApply">
        <option value="one">Cette demi-journée uniquement</option>
        <option value="day">Journée complète</option>
        <option value="week">Semaine entière (cet employé)</option>
      </select>
    </div>
  </div>
  <div class="mfooter">
    <button class="btn btn-ghost" onclick="closeM('m-cell')">Annuler</button>
    <button class="btn btn-cyan" onclick="saveCellEdit()">Valider</button>
  </div>
</div>
</div>

