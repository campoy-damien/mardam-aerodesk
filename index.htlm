    'color:#ff4d6d;font-size:11px;');
  console.log('%cMARDAM AeroDesk Pro — Propriété intellectuelle protégée.',
    'color:#a0b0c0;font-size:10px;');
})();

window.addEventListener('DOMContentLoaded',()=>{ try{
  load();
  if(!S.weekStart)S.weekStart=getMon(new Date());
  if(!S.holidays||!S.holidays.length)loadFR2026(true);
  if(!S.gdrive) S.gdrive={connected:false,gasUrl:'',lastSync:null,lastPushOk:null};
  if(!S.autorisations) S.autorisations=[];

  // Remplir les sélecteurs d'années 2026–2090
  const curYear = new Date().getFullYear();
  ['mp-year','gantt-year'].forEach(id=>{
    const sel=document.getElementById(id); if(!sel) return;
    sel.innerHTML='';
    for(let y=2026;y<=2090;y++){
      const o=document.createElement('option');
      o.value=y; o.textContent=y;
      if(y===curYear) o.selected=true;
      sel.appendChild(o);
    }
  });
  popSelects();updateDriveUI();renderDash();

  // PWA install
  let dPr;
  window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();dPr=e;const b=document.createElement('button');b.className='hbtn hbtn-primary';b.innerHTML='📲 Installer';b.onclick=()=>{dPr.prompt();dPr=null;b.remove();};document.querySelector('.header-right').prepend(b);});
}catch(e){console.error('Init error:',e);document.body.innerHTML='<div style="padding:40px;color:#fff;font-family:sans-serif;background:#060a12;min-height:100vh"><h2>⚠️ Erreur au démarrage</h2><p>'+e.message+'</p><p>Ouvre ce fichier dans <strong>Safari</strong> (pas QuickLook).</p></div>';}
});
