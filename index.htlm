<!-- Chantier -->
<div class="mbg" id="m-chantier">
<div class="modal">
  <div class="modal-title">🔧 Chantier</div>
  <input type="hidden" id="ci">
  <div class="fgrid">
    <div class="field" style="grid-column:1/-1"><label>Intitulé *</label><input type="text" id="c-nom" placeholder="Ex: Air France A320 MSN2341 — Visite C"></div>
    <div class="field"><label>Client</label><input type="text" id="c-client"></div>
    <div class="field"><label>Statut</label>
      <select id="c-statut"><option value="prevision">🔮 Prévision</option><option value="futur">📅 À venir</option><option value="encours">🔄 En cours</option><option value="termine">✅ Terminé</option></select>
    </div>
    <div class="field"><label>Responsable Projet</label><select id="c-resp"></select></div>
    <div class="field"><label>Chef d'équipe</label><select id="c-chef"></select></div>
