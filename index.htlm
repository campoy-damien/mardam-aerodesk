window.onerror = function(msg, src, line, col, err){
  console.error('AeroStaff Error:', msg, 'line:'+line, err?.stack||'');
  return false;
};


// ── Copyright Protection ──
(function(){
  // Désactiver clic droit
  document.addEventListener('contextmenu', function(e){
    e.preventDefault();
    return false;
  });
  // Protéger contre le copier-coller du code source
  document.addEventListener('keydown', function(e){
    // Bloquer Ctrl+U (voir source), Ctrl+S (sauvegarder), Ctrl+Shift+I (DevTools)
    if(e.ctrlKey && (e.key==='u'||e.key==='U'||e.key==='s'||e.key==='S')){
      e.preventDefault();
      return false;
    }
  });
  // Copyright dans la console
  console.log('%c© 2025 Damien Campoy — MARDAM AeroDesk Pro',
    'color:#00d2ff;font-size:14px;font-weight:bold;padding:8px');
