      <select id="f-type">
        <option>CACES NACELLE</option><option>CACES CHARIOT</option><option>CACES TRACMA</option><option>CACES TELESCO</option><option>CACES GERBEUR</option><option>EWIS</option><option>CDCCL</option><option>SAFETY TRAINING</option>
