    <div class="field"><label>Date fin prévue</label><input type="date" id="c-fin"></div>
    <div class="field" style="grid-column:1/-1"><label>Description</label><textarea id="c-desc" rows="2"></textarea></div>

    <!-- Volume horaire + calcul auto -->
    <div class="field" style="grid-column:1/-1">
      <label>Volume horaire du chantier (Man/Hours)</label>
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:4px">
        <div style="display:flex;align-items:center;gap:8px">
          <input type="number" id="c-manhours" min="0" value="0" placeholder="Ex: 560" style="width:90px;text-align:center;font-size:16px;font-weight:700" oninput="calcTechBesoin()">
          <span style="font-size:13px;color:var(--t2)">Man/Hours <span style="font-size:10px;color:var(--t4)">(1 tech = 7h/jour)</span></span>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" onclick="calcTechBesoin()" style="flex-shrink:0">⚙️ Calculer besoin</button>
      </div>
      <div id="c-calcResult" style="margin-top:8px;font-size:12px;color:var(--cyan);display:none"></div>
    </div>

    <div class="field" style="grid-column:1/-1">
      <label>Techniciens nécessaires <span style="font-size:10px;color:var(--t4);font-weight:400">(calculé auto ou saisie manuelle)</span></label>
      <div id="c-ressources-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px;margin-top:4px">
        <div style="display:flex;align-items:center;gap:6px">
          <input type="number" id="r-technicien" min="0" value="0" style="width:52px;text-align:center;padding:6px">
          <span style="font-size:12px;color:var(--t2)">Techniciens</span>
        </div>
      </div>
    </div>
    <div class="field" style="grid-column:1/-1"><label>Équipe assignée</label>
      <select id="c-equipe" multiple style="height:80px"></select>
      <span style="font-size:10px;color:var(--t4);margin-top:3px">Ctrl+clic pour multi-sélection</span>
    </div>
    <div class="field" style="grid-column:1/-1">
      <label>Couleur du chantier</label>
      <div class="swatches" id="cSwatches"></div>
      <input type="hidden" id="c-color" value="#2979ff">
    </div>
  </div>
  <div class="mfooter">
    <button class="btn btn-ghost" onclick="closeM('m-chantier')">Annuler</button>
    <button class="btn btn-rose btn-sm" id="c-delbtn" onclick="deleteChantier()" style="display:none">🗑 Supprimer</button>
    <button class="btn btn-cyan" onclick="saveChantier()">Sauvegarder</button>
  </div>
</div>
</div>

