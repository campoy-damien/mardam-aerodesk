<script>

// Safe localStorage wrapper (fallback for QuickLook/file:// restrictions)
var _memStore = {};
var _safeStorage = {
  getItem: function(k){ try{ return localStorage.getItem(k); } catch(e){ return _memStore[k]||null; } },
  setItem: function(k,v){ try{ localStorage.setItem(k,v); } catch(e){ _memStore[k]=v; } },
  removeItem: function(k){ try{ localStorage.removeItem(k); } catch(e){ delete _memStore[k]; } }
};
// Load SheetJS dynamically with fallback for offline/QuickLook
(function(){
  var s=document.createElement('script');
  s.src='https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';
  s.onerror=function(){
    window._xlsxFailed=true;
    console.warn('SheetJS not available - Excel export disabled');
  };
  document.head.appendChild(s);

// Copyright protection
document.addEventListener('contextmenu',function(e){e.preventDefault();});
document.addEventListener('keydown',function(e){if(e.ctrlKey&&(e.key==='u'||e.key==='U')){e.preventDefault();}});
console.log('%c© 2025 Damien Campoy — MARDAM AeroDesk Pro','color:#00d2ff;font-size:14px;font-weight:bold');
})();
